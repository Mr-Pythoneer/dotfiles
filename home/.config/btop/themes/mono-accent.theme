# Black and white like the rest of the desktop (Caelestia's monochrome scheme), with a little colour where it
# means something: load and temperature go green -> amber -> red, memory and network get their own soft tones.
# Same colours as the rice bar's panels (~/.config/quickshell/rice/services/Theme.qml). Made 2026-10-14.
# Caelestia regenerates themes/caelestia.theme on scheme changes but never this file; btop.conf picks it.

theme[main_bg]=""
theme[main_fg]=#e2e2e2
theme[title]=#e2e2e2
theme[hi_fg]=#ffffff
theme[selected_bg]=#2a2a2a
theme[selected_fg]=#ffffff
theme[inactive_fg]=#7a7a7a
theme[graph_text]=#c6c6c6
theme[meter_bg]=#353535
theme[proc_misc]=#c6c6c6

# box outlines stay grey
theme[cpu_box]=#5e5e5e
theme[mem_box]=#5e5e5e
theme[net_box]=#5e5e5e
theme[proc_box]=#5e5e5e
theme[div_line]=#474747

# temperature: green -> amber -> red
theme[temp_start]=#a6da95
theme[temp_mid]=#eed49f
theme[temp_end]=#ed8796

# CPU load: green -> amber -> red
theme[cpu_start]=#a6da95
theme[cpu_mid]=#eed49f
theme[cpu_end]=#ed8796

# memory and disks
theme[free_start]=#8bd5ca
theme[free_mid]=#8bd5ca
theme[free_end]=#a6da95
theme[cached_start]=#8aadf4
theme[cached_mid]=#8aadf4
theme[cached_end]=#b7bdf8
theme[available_start]=#c6a0f6
theme[available_mid]=#c6a0f6
theme[available_end]=#b7bdf8
theme[used_start]=#a6da95
theme[used_mid]=#eed49f
theme[used_end]=#ed8796

# network: download blue, upload mauve (as in the dashboard)
theme[download_start]=#5b6f9a
theme[download_mid]=#8aadf4
theme[download_end]=#b7c9f8
theme[upload_start]=#7d6799
theme[upload_mid]=#c6a0f6
theme[upload_end]=#dcc4fa

# processes: cpu/mem use per process, green -> amber -> red
theme[process_start]=#a6da95
theme[process_mid]=#eed49f
theme[process_end]=#ed8796
