# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #131313
selected_bg = #1f1f1f
header_bg = #474747

# Text colors
text = #e2e2e2
selected_text = #ffffff
header_text = #c6c6c6
inactive_text = #919191

# GPU utilization colors (gradient from low to high)
gpu_util_low = #f0f0f0
gpu_util_med = #f5f5f5
gpu_util_high = #e1e1e1

# Memory usage colors
memory_low = #f0f0f0
memory_med = #e8e8e8
memory_high = #e4e4e4

# Temperature colors (cool to hot)
temp_cool = #f0f0f0
temp_warm = #f5f5f5
temp_hot = #e1e1e1

# Power usage colors
power_low = #f0f0f0
power_med = #e9e9e9
power_high = #e4e4e4

# Process list colors
process_normal = #e2e2e2
process_highlight = #ffffff
process_killed = #e1e1e1

# Border and separator colors
border = #919191
separator = #474747

# Chart and graph colors
chart_line = #e2e2e2
chart_fill = #1f1f1f

# Status indicators
status_ok = #f0f0f0
status_warning = #f5f5f5
status_error = #e1e1e1
status_info = #e4e4e4
