def render(stories, summary, reason, now, failed=(), prev=""):
    e = html.escape
    byid = {s["id"]: s for t in TOPICS for s in stories[t]}
    cited = {i for t in TOPICS for p in (summary or {}).get(t, []) for i in p["sources"]}
    name = edition_name(now)
    outlets = sorted({s["source"] for s in byid.values()})

    def chips(ids):
        out, count = "", {}
        for i in ids:
            src = byid[i]["source"]
            count[src] = count.get(src, 0) + 1
            label = src if count[src] == 1 else f"{src} {count[src]}"  # two stories from one outlet
            out += (f'<a class="chip" href="{e(byid[i]["url"])}" target="_blank" rel="noopener" '
                    f'title="{e(byid[i]["title"])}">{e(label)}</a>')
        return out

    if summary:
        tldr = f'<p class="tldr">{e(summary["tldr"])}</p>' if summary["tldr"] else ""
        cols = ""
        for t, label in TOPICS.items():
            items = "".join(
                f'<li>{"<b>" + e(p["title"]) + "</b>" if p["title"] else ""}<p>{e(p["text"])}</p>'
                f'{"<div class=cites>" + chips(p["sources"]) + "</div>" if p["sources"] else ""}</li>'
                for p in summary[t]) or '<li><p class="note">Nothing new here.</p></li>'
            cols += f'<div><h2>{label}</h2><ol class="points">{items}</ol></div>'
        top = f'{tldr}<div class="cols">{cols}</div>'
    else:
        top = f'<p class="note">No summary this time: {e(reason)}. Here are the stories.</p>'

    lists = ""
    for t, label in TOPICS.items():
        rows = ""
        for s in stories[t]:
            meta = f'<span class="src">{e(s["source"])}</span>'
            if s["published"]:
                meta += f' · {e(when_label(s["published"], now))}'
            if s["id"] in cited:
                meta += '<span class="cited">in summary</span>'
            blurb = f'<span class="blurb">{e(s["summary"])}</span>' if s["summary"] else ""
            extra = (f'<div class="extra"><a href="{e(s["comments"])}" target="_blank" rel="noopener">'
                     f'Discussion</a></div>') if s["comments"] else ""
            rows += (f'<li id="s{s["id"]}"><a class="story" href="{e(s["url"])}" target="_blank" rel="noopener">'
                     f'<span class="meta">{meta}</span><span class="title">{e(s["title"])}</span>{blurb}</a>{extra}</li>')
        lists += f'<div><h2>{label} · {len(stories[t])}</h2><ul class="list">{rows or "<li><p class=note>No stories.</p></li>"}</ul></div>'

    foot = [f"{len(byid)} stories from {len(outlets)} outlets" + (" · summary by Claude" if summary else "")]
    if failed:
        foot.append(e("Couldn't reach: " + ", ".join(f.split(":")[0] for f in failed)))
    if prev:
        foot.append(f'<a href="{e(prev)}">← Previous edition</a>')
    stamp = now.strftime("%A, %B %-d · %-I:%M %p")
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{name} news</title><style>{CSS % colours()}</style></head>
<body><main>
<header><div class="kicker">{e(stamp)}</div><h1>{name} news</h1></header>
<section class="summary" aria-label="Summary">{top}</section>
<section class="sources"><h2>Sources</h2><p>Every story the summary was written from. Click one to read it at the outlet.</p>
<div class="cols">{lists}</div></section>
<footer>{"".join(f"<span>{x}</span>" for x in foot)}</footer>
</main></body></html>
"""


# ---------- editions ----------

def build(config=None):
    """Fetch, summarise, write the page. Returns (path, summary, top stories) or None if offline."""
    config = config or load_config()
    now = datetime.now().astimezone()
    stories, failed = fetch_all(config["feeds"])
    for f in failed:
        log(f"feed failed: {f}")
    if not stories:
        log("no stories fetched (offline?)")
        return None
    # Cover what happened since the last edition: at least the last 10 hours, at most 36.
    state = load_state()
    last = parse_date(state.get("built")) or now - timedelta(hours=14)
    since = max(now - timedelta(hours=36), min(now - timedelta(hours=10), last))
    picked = select(stories, since, int(config["per_feed"]), int(config["per_topic"]), oldest=now - timedelta(hours=36))
    n = 0
    for t in TOPICS:
        for s in picked[t]:
            n += 1
            s["id"] = n
    summary, reason = summarize(picked, config)
    if not summary:
        log(f"no summary: {reason}")

    eds = DATA / "editions"
    eds.mkdir(parents=True, exist_ok=True)
    older = sorted(eds.glob("*.html"))
    path = eds / f"{now:%Y-%m-%d-%H%M}-{edition_name(now).lower()}.html"
    prev = older[-1].name if older and older[-1] != path else ""
    path.write_text(render(picked, summary, reason, now, failed, prev))
    for old in [o for o in older if o != path][:max(0, len(older) + 1 - KEEP)]:
        old.unlink()
    latest = DATA / "latest.html"
    latest.unlink(missing_ok=True)
    latest.symlink_to(path.relative_to(DATA))
    save_state(built=now.isoformat(), path=str(path))
    log(f"built {path.name}: {n} stories, summary={'yes' if summary else 'no'}")
    return path, summary, picked


def open_page(path=None):
    path = Path(path or DATA / "latest.html")
    if not path.exists():
        sys.exit("No edition yet. Run: news-brief")
    subprocess.Popen(["xdg-open", path.resolve().as_uri()], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def teaser(summary, stories):
    if summary and summary["tldr"]:
        text = summary["tldr"]
    else:
        text = " · ".join(stories[t][0]["title"] for t in TOPICS if stories[t])
    return text if len(text) <= 180 else text[:180].rsplit(" ", 1)[0] + "…"


def locked():
    try:
        out = subprocess.run(["qs", "-c", "caelestia", "ipc", "call", "lock", "isLocked"],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return out.strip() == "true"


def delivery_time(now):
    """The timer fires a couple of minutes early so the summary is ready on the dot:
    deliver at the next :00 or :30 if that's within 5 minutes, otherwise right away."""
    mark = now.replace(second=0, microsecond=0) + timedelta(minutes=1)
    while mark.minute % 30:
        mark += timedelta(minutes=1)
    return mark if mark - now <= timedelta(minutes=5) else now


def scheduled():
    state = load_state()
    last = parse_date(state.get("delivered"))
    if last and datetime.now(timezone.utc) - last < timedelta(hours=3):
        log("skipped: an edition was delivered less than 3 hours ago")  # e.g. a missed 20:30 caught up at 7:00
        return
    if not wait_online():
        log("skipped: offline")
        return
    built = build()
    if not built:
        return
    built_at = time.time()
    wait = (delivery_time(datetime.now().astimezone()) - datetime.now().astimezone()).total_seconds()
    if wait > 0:
        time.sleep(wait)
    # Laptop asleep or locked: hold the notification until you're back (give up after 12 hours),
    # and rebuild if the news has gone stale in the meantime.
    deadline = time.time() + 12 * 3600
    while locked():
        if time.time() > deadline:
            log("skipped: locked all day")
            return
        time.sleep(15)
    if time.time() - built_at > 3600:
        time.sleep(10)  # Wi-Fi reconnecting after resume
        built = build() or built
    path, summary, stories = built
    save_state(delivered=datetime.now().astimezone().isoformat())
    # The notification can sit in the centre for hours; let a child wait for the click
    # so the service finishes and the next run isn't blocked.
    if os.fork() > 0:
        os._exit(0)
    name = edition_name(datetime.now())
    cmd = ["notify-send", "-a", "News", "-i", "com.gitlab.newsflash", "-t", "20000",
           "-A", "open=Read the news", f"Your {name.lower()} news is ready",
           f"Want to see it? {teaser(summary, stories)}"]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=16 * 3600).stdout
    except subprocess.TimeoutExpired:
        return
    if out.strip() == "open":
        open_page(path)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--scheduled":
        scheduled()
    elif arg == "--open":
        open_page()
    elif arg in ("--build", ""):
        print("Fetching the news and writing the summary…", file=sys.stderr, flush=True)
        built = build()
        if not built:
            sys.exit("Couldn't fetch any news (offline?)")
        if arg == "--build":
            print(built[0])
        else:
            open_page(built[0])
    elif arg in ("-h", "--help"):
        print(__doc__.strip())
    else:
        sys.exit(f"Unknown option {arg} (try: news-brief --help)")


if __name__ == "__main__":
    main()
