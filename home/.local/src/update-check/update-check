               "rice": "The bar (the rice shell, with its dashboard, control centre and to-do panel)"}
# Quickshell lines that mean part of a shell didn't load (an API that changed under it), not passing noise
QS_LOAD_ERROR = re.compile(r"is not a type|is not installed|module \"[^\"]+\" (is not installed|version)|"
                           r"Cannot assign to non-existent property|Type \S+ unavailable|plugin cannot be loaded|"
                           r"Non-existent attached object|Invalid property assignment|Failed to load|"
                           r"No such file or directory.*\.qml", re.I)
BACKUP_NAME = re.compile(r"\.(bak|orig|archinstall|old)\b|~$")
SH_NOT_COMMANDS = set("""if then else elif fi for while until do done case esac in function select time ! [[ ]] [ test
    { } ( ) echo printf read cd export local return exit set unset shift source . eval exec trap wait true false
    break continue declare typeset readonly let getopts command type hash ulimit umask kill pwd alias unalias
    builtin mapfile readarray pushd popd dirs disown jobs fg bg suspend shopt enable caller compgen complete""".split())
# commands that run another command: wrapper -> its options that take a value (sudo -u USER cmd)
SH_WRAPPERS = {"sudo": {"-u", "-g", "-C", "-D", "-p", "-r", "-t", "-U", "-h"}, "env": {"-u", "-C", "-S"},
               "timeout": {"-s", "-k"}, "nice": {"-n"}, "exec": {"-a"}, "nohup": set(), "setsid": set(),
               "command": set(), "time": set(), "xargs": {"-I", "-n", "-P", "-d", "-a", "-E", "-L", "-s"}}
COMMAND = re.compile(r"^([A-Za-z_][\w.+-]*|~?/[\w./+-]+)$")
PY_CALL = re.compile(r"(?:run|call|Popen|check_output|check_call)\(\s*\[\s*[\"']([\w.+-]+)[\"']")
LUA_STR = r'"(?:[^"\\\n]|\\.)*"' + r"|'(?:[^'\\\n]|\\.)*'"
LUA_UNKNOWN = "$lua"  # a value only known when Hyprland runs; not checked


def shell_skeleton(text):
    """A shell script with comments, quoted text, heredoc bodies and arithmetic removed, so only the
    commands are left; $(...) is kept, also inside double quotes."""
    out, i, n = [], 0, len(text)
    stack, depth, heredocs = ["code"], [0], []
    while i < n:
        c = text[i]
        if stack[-1] == "dq":
            if c == "\\":
                i += 2
            elif c == '"':
                stack.pop()
                out.append('"')
                i += 1
            elif text.startswith("$((", i):
                j = text.find("))", i)
                i = n if j < 0 else j + 2
            elif text.startswith("$(", i):
                stack.append("code")
                depth.append(0)
                out.append(" $( ")
                i += 2
            else:
                i += 1
            continue
        if c == "\\":
            i += 2
            continue
        if c == "#" and (i == 0 or text[i - 1] in " \t\n;"):
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        if c == "'":
            j = text.find("'", i + 1)
            out.append("''")
            i = n if j < 0 else j + 1
            continue
        if c == '"':
            stack.append("dq")
            out.append('"')
            i += 1
            continue
        if text.startswith("$((", i) or text.startswith("((", i):
            j = text.find("))", i)
            out.append(" 0 ")
            i = n if j < 0 else j + 2
            continue
        if text.startswith("$(", i):
            stack.append("code")
            depth.append(0)
            out.append(" $( ")
            i += 2
            continue
        if c == "(":
            depth[-1] += 1
        elif c == ")":
            if depth[-1] == 0 and len(stack) > 1:
                stack.pop()
                depth.pop()
                out.append(" ) ")
                i += 1
                continue
            depth[-1] -= 1
        m = re.match(r"<<-?\s*(['\"]?)(\w+)\1", text[i:i + 40])
        if m:
            heredocs.append(m.group(2))
            out.append(" ")
            i += m.end()
            continue
        if c == "\n" and heredocs:
            out.append("\n")
            for d in heredocs:  # skip each heredoc body, up to its closing line
                m = re.compile(rf"^\s*{re.escape(d)}\s*$", re.M).search(text, i + 1)
                i = n if not m else m.end()
            heredocs = []
            continue
        out.append(c)
        i += 1
    return "".join(out)


def shell_commands(text):
    """Commands a shell script (or command line) runs: {command: line}."""
    funcs = set(re.findall(r"^\s*(?:function\s+)?([\w.-]+)\s*\(\)", text, re.M))
    funcs |= set(re.findall(r"^\s*function\s+([\w.-]+)", text, re.M))
    guarded = set(re.findall(r"(?:command -v|which|type -p|hash)\s+([\w.+-]+)", text))  # optional ones
    cmds = {}
    for n, line in enumerate(shell_skeleton(text).splitlines(), 1):
        line = re.sub(r"^\s*\(?[^\s()]+\)\s", " ", line)  # case pattern:  foo|bar)  cmd
        line = re.sub(r"\b\w+\+?=\([^)]*\)", " ", line)  # array assignment:  dirs=(/a /b) holds values, not commands
        for part in re.split(r"\$\(|;|&&|\|\||\||\bthen\b|\bdo\b|\belse\b|\{|\(|!|&", line):
            words = part.split()
            while words and re.match(r"^\w+(\[[^]]*\])?\+?=", words[0]):  # VAR=value cmd
                words.pop(0)
            while words and words[0] in SH_WRAPPERS:  # sudo -u x cmd, timeout 5 cmd, ...
                takes_value = SH_WRAPPERS[words.pop(0)]
                while words and (words[0].startswith("-") or words[0][:1].isdigit() or "=" in words[0]):
                    if words.pop(0) in takes_value and words:
                        words.pop(0)
            if words and COMMAND.match(words[0]) and words[0] not in SH_NOT_COMMANDS | funcs | guarded:
                cmds.setdefault(words[0], n)
    return cmds


def py_commands(text):
    """Commands a Python script runs through subprocess: {command: line}; ones it checks with which() are optional."""
    guarded = set(re.findall(r"which\(\s*[\"']([\w.+-]+)", text))
    cmds = {}
    for n, line in enumerate(text.splitlines(), 1):
        for c in PY_CALL.findall(line):
            if c not in guarded:
                cmds.setdefault(c, n)
    return cmds


def command_exists(c):
    if c.startswith(("/", "~")):
        p = Path(os.path.expanduser(c))
        return p.is_file() and os.access(p, os.X_OK)
    return shutil.which(c) is not None


def provider(c):
    """The repo package that has /usr/bin/<c>, or None (needs pacman's file lists: sudo pacman -Fy)."""
    if c.startswith(("/", "~")) or not glob.glob("/var/lib/pacman/sync/*.files"):
        return None
    rc, out, _ = run(["pacman", "-Fq", f"/usr/bin/{c}"], timeout=30)
    return out.split()[0].split("/")[-1] if rc == 0 and out.strip() else None


def missing_commands(cmd):
    """Commands in a command line that aren't installed, including inside sh -c '...'."""
    names = list(shell_commands(cmd))
    for m in re.finditer(r"\b(?:ba)?sh\s+-c\s+(['\"])(.*?)\1", cmd):
        names += shell_commands(m.group(2))
    return [c for c in dict.fromkeys(names) if not command_exists(c)]


def lua_config_files():
    """hyprland.lua and every file it require()s: (files found, files missing)."""
    files, missing, todo = [], [], [HYPR / "hyprland.lua"]
    while todo:
        f = todo.pop(0)
        if f in files or f in missing:
            continue
        if not f.is_file():
            missing.append(f)
            continue
        files.append(f)
        for m in re.finditer(r"^[^-\n]*\brequire\s*\(?\s*[\"']([\w.]+)[\"']", f.read_text(errors="replace"), re.M):
            todo.append(HYPR / (m.group(1).replace(".", "/") + ".lua"))
    return files, missing


def lua_comment_start(line):
    """Where a Lua -- comment starts on this line (len(line) if none); -- inside a string doesn't count."""
    for m in re.finditer(rf"{LUA_STR}|--", line):
        if m.group(0) == "--":
            return m.start()
    return len(line)


def lua_exec_commands(text):
    """[(line, command)] for each exec_cmd(...) in Hyprland's Lua config, with local string variables filled in."""
    names = {m.group(1): m.group(2)[1:-1]
             for m in re.finditer(rf"^\s*local\s+(\w+)\s*=\s*({LUA_STR})\s*(?:--.*)?$", text, re.M)}
    found = []
    for m in re.finditer(rf"exec_cmd\(\s*((?:{LUA_STR}|\w+|\s*\.\.\s*)+?)\s*[,)]", text):
        start = text.rfind("\n", 0, m.start()) + 1
        end = text.find("\n", m.start())
        line = text[start:end if end >= 0 else len(text)]
        if lua_comment_start(line) < m.start() - start:
            continue  # commented out
        parts = re.findall(rf"{LUA_STR}|\w+", m.group(1))
        cmd = "".join(p[1:-1] if p[0] in "\"'" else names.get(p, f" {LUA_UNKNOWN} ") for p in parts)
        found.append((text.count("\n", 0, m.start()) + 1, cmd))
    return found


def lua_path_literals(text):
    """[(line, path)] for file paths written in the Lua config (outside exec_cmd, which is checked as a command)."""
    found = []
    for n, line in enumerate(text.splitlines(), 1):
        code = line[:lua_comment_start(line)]
        if "exec_cmd(" in code:
            continue
        for m in re.finditer(LUA_STR, code):
            s = m.group(0)[1:-1]
            if re.fullmatch(r"(~|/home|/etc|/usr|/opt)/[^\s'\"$]*", s):
                found.append((n, s))
    return found


def startup_problems():
    """Every program the Hyprland config starts or binds to a key, and every file it names, must exist."""
    files, gone = lua_config_files()
    if not files:
        return [], 0
    found = [Problem(f"hyprland.lua loads {f.name}, which is missing.") for f in gone]
    checked, missing = 0, {}
    luac = shutil.which("luac")
    for f in files:
        text = f.read_text(errors="replace")
        if luac:
            rc, _, err = run([luac, "-p", str(f)], timeout=30)
            if rc != 0:
                found.append(Problem(f"{f.name} has a syntax error: {(err.strip().splitlines() or ['?'])[-1]}"))
        for line, cmd in lua_exec_commands(text):
            checked += 1
            for c in missing_commands(cmd):
                missing.setdefault(c, []).append(f"{f.name}:{line}")
        by_line = {}
        for line, path in lua_path_literals(text):
            by_line.setdefault(line, []).append(path)
        for line, paths in by_line.items():
            checked += 1
            # several paths on one line are alternatives (use whichever exists): fine if any of them does
            if not any(Path(os.path.expanduser(p)).exists() for p in paths):
                found.append(Problem(f"{f.name}:{line} refers to {' / '.join(paths)}, which doesn't exist."))
    for c, where in missing.items():
        pkg = provider(c)
        what = f"{', '.join(where[:3])} starts `{c}`, which " + ("doesn't exist." if c.startswith(("/", "~")) else "isn't installed.")
        found.append(Problem(what, f"sudo pacman -S {pkg}", f"Installs {pkg}, which provides {c}.", verify=lambda c=c: command_exists(c))
                     if pkg else Problem(what))
    return found, checked


def unit_problems():
    """Your systemd user services: the programs they run exist, and nothing enabled points at a deleted unit."""
    found, checked = [], 0
    for f in sorted(UNITS.glob("*.service")):
        for line in f.read_text(errors="replace").splitlines():
            m = re.match(r"^\s*Exec\w*\s*=\s*[-@:+!|]*(\S+)", line)
            if not m:
                continue
            c = m.group(1).replace("%h", str(HOME))
            if "%" in c or "$" in c:
                continue
            checked += 1
            if not command_exists(c):
                found.append(Problem(f"Your service {f.name} runs {c}, which doesn't exist."))
    for link in sorted(UNITS.glob("*.wants/*")):
        checked += 1
        if link.is_symlink() and not link.exists():
            found.append(Problem(f"{link.name} is enabled ({link.parent.name}) but its unit file is gone: {os.readlink(link)}"))
    return found, checked


def script_problems():
    """Your scripts in ~/.local/bin: the interpreter exists, they parse, and the commands they run are installed."""
    found, checked = [], 0
    try:
        scripts = sorted(BIN.iterdir())
    except OSError:
        return [], 0
    for f in scripts:
        if BACKUP_NAME.search(f.name) or not f.is_file() or is_elf(f):
            continue
        try:
            text = f.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        if not text.startswith("#!"):
            continue
        checked += 1
        shebang = text.split("\n", 1)[0][2:].split()
        interp = shebang[1] if len(shebang) > 1 and shebang[0].endswith("/env") else (shebang[0] if shebang else "")
        if not command_exists(interp):
            found.append(Problem(f"{f.name}: its interpreter {interp} isn't installed."))
            continue
        kind = Path(interp).name
        if kind.startswith("python"):
            try:
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore")
                    compile(text, str(f), "exec", dont_inherit=True)
            except (SyntaxError, ValueError) as e:
                found.append(Problem(f"{f.name} has a syntax error (line {getattr(e, 'lineno', '?')}): {getattr(e, 'msg', e)}"))
                continue
            cmds = py_commands(text)
        elif kind in ("sh", "bash", "dash"):
            rc, _, err = run([interp, "-n", str(f)], timeout=30)
            if rc != 0:
                found.append(Problem(f"{f.name} has a syntax error: {(err.strip().splitlines() or ['?'])[-1]}"))
                continue
            cmds = shell_commands(text)
        else:
            continue
        for c, line in cmds.items():
            if not command_exists(c):
                pkg = provider(c)
                found.append(Problem(f"{f.name} (line {line}) runs `{c}`, which isn't installed"
                                     + (f"; it's in {pkg}: sudo pacman -S {pkg}" if pkg else "") + "."))
    return found, checked


def config_problems():
    """Config files that must parse: Caelestia's JSON settings and this tool's own config."""
    found, checked = [], 0
    for f in sorted((HOME / ".config/caelestia").glob("*.json")):
        checked += 1
        try:
            json.loads(f.read_text())
        except (OSError, ValueError) as e:
            found.append(Problem(f"{f} isn't valid JSON ({e}), so Caelestia ignores your settings in it."))
    if CONFIG.exists():
        checked += 1
        _, err = load_config()
        if err:
            found.append(Problem(err))
    return found, checked


def patched_files(patch_text):
    """Files a -p1 patch writes to (its +++ b/... lines)."""
    return [m.group(1) for m in re.finditer(r"^\+\+\+ [^/\s]+/(\S+)", patch_text, re.M)]


def caelestia_copy_problems():
    """The patched Caelestia copy the shell runs from must equal what caelestia-patch would make now:
    the installed Caelestia with your patches applied. Checked exactly, by building that in a temp dir."""
    patches = sorted(CAELESTIA_PATCHES.glob("*.patch"))
    if not CAELESTIA_SRC.is_dir() or not (patches or CAELESTIA_COPY.is_dir()):
        return [], 0  # not this setup

    def problem(what):
        return Problem(what, "caelestia-patch", "Copies the installed Caelestia again, re-applies your patches "
                       "and restarts the shell.", verify=lambda: not caelestia_copy_problems()[0])

    if not CAELESTIA_COPY.is_dir():
        return [problem(f"Your patched Caelestia copy ({CAELESTIA_COPY}) is missing, so the shell runs without your patches.")], 1
    shipped = {str(p.relative_to(CAELESTIA_SRC)) for p in CAELESTIA_SRC.rglob("*") if p.is_file()}
    touched = {f for p in patches for f in patched_files(p.read_text(errors="replace"))}
    found, differ = [], []
    for rel in sorted(shipped - touched):
        try:
            same = (CAELESTIA_SRC / rel).read_bytes() == (CAELESTIA_COPY / rel).read_bytes()
        except OSError:
            same = False
        if not same:
            differ.append(rel)
    if touched and shutil.which("patch"):
        with tempfile.TemporaryDirectory() as tmp:
            for rel in touched & shipped:
                Path(tmp, rel).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(CAELESTIA_SRC / rel, Path(tmp, rel))
            broken = []
            for p in patches:
                try:
                    with open(p, "rb") as f:
                        rc = subprocess.run(["patch", "-d", tmp, "-p1", "--forward", "-s", "-f"], stdin=f,
                                            capture_output=True, timeout=30).returncode
                except (OSError, subprocess.TimeoutExpired):
                    rc = 1
                if rc != 0:
                    broken.append(p.name)
            if broken:
                found.append(Problem(f"Your patch(es) {', '.join(broken)} no longer apply to the installed Caelestia, so "
                                     "caelestia-patch would stop (your current copy stays as it is). They need redoing "
                                     f"by hand against {CAELESTIA_SRC}."))
            else:
                for rel in sorted(touched):
                    try:
                        same = Path(tmp, rel).read_bytes() == (CAELESTIA_COPY / rel).read_bytes()
                    except OSError:
                        same = False
                    if not same:
                        differ.append(rel)
    if differ:
        found.append(problem(f"{len(differ)} file(s) in your patched Caelestia copy aren't what the installed Caelestia "
                             f"plus your patches gives (e.g. {', '.join(differ[:3])}): Caelestia changed since the copy was made, "
                             "or a patch isn't applied."))
    return found, len(shipped) + len(patches)


def running_shells():
    """Quickshell instances running now: {config folder name: pid}. Asks Quickshell itself, because after a
    crash it restarts the shell in place and the process is then just /usr/bin/quickshell."""
    rc, out, _ = run(["qs", "list", "--all", "--json"], timeout=15)
    try:
        items = json.loads(out) if rc == 0 else []
    except ValueError:
        items = []
    return {Path(i["config_path"]).parent.name: i["pid"] for i in items if i.get("config_path")}


def autostarted_shells():
    """Quickshell configs your Hyprland config starts: {config name: (file:line, command)}."""
    found = {}
    for f in lua_config_files()[0]:
        for line, cmd in lua_exec_commands(f.read_text(errors="replace")):
            m = re.search(r"\b(?:qs|quickshell)\b(?=.*\s-c\s+([\w.-]+))", cmd) or re.search(r"\bcaelestia shell\b()", cmd)
            if m and "ipc" not in cmd.split():
                name = m.group(1) or "caelestia"
                if (QS_CONFIGS / name / "shell.qml").is_file():
                    found.setdefault(name, (f"{f.name}:{line}", cmd))
    return found


def start_shell_cmd(name, cmd=None):
    """Start a shell the way login does (through Hyprland, so it lives in the session like the rest), and
    never as a second copy: -n makes Quickshell refuse when that config is already running."""
    cmd = cmd or ("caelestia shell -d" if name == "caelestia" else f"qs -c {name} -d")
    if re.search(r"\b(qs|quickshell)\b", cmd) and not re.search(r"\s-n\b|--no-duplicate", cmd):
        cmd = re.sub(r"\s-c\s+(\S+)", r" -c \1 -n", cmd, count=1)
    lua = cmd.replace("\\", "\\\\").replace('"', '\\"')
    return f"hyprctl eval 'hl.exec_cmd(\"{lua}\")' >/dev/null"


def shell_log_errors(pid):
    """Distinct lines in a running shell's log saying part of it failed to load."""
    rc, out, _ = run(["qs", "log", "--pid", str(pid)], timeout=30)
    seen = []
    for line in re.sub(r"\x1b\[[0-9;]*m", "", out).splitlines():
        if QS_LOAD_ERROR.search(line):
            msg = re.sub(r"\s+", " ", line.split(":", 1)[-1]).strip()
            if msg not in seen:
                seen.append(msg)
    return seen


def shell_problems(custom):
    """Quickshell matches the installed Qt; every shell your Hyprland config starts is running; and no
    running shell logged that part of it failed to load (only checked inside the desktop session)."""
    found, checked = [], 0
    qs = shutil.which("quickshell")
    if qs:
        checked += 1
        if run([qs, "--private-check-compat"], timeout=30)[0] != 0:
            owner = run(["pacman", "-Qoq", qs])[1].strip()
            e = custom.get(owner, {})
            found.append(Problem(f"Quickshell ({owner or qs}) was built for a different Qt than the one installed, so the shell "
                                 "will probably crash.", e.get("rebuild") or "arch-update",
                                 "Rebuilds Quickshell for the Qt now installed.", tuple(e.get("after", ())),
                                 lambda: run([qs, "--private-check-compat"], timeout=30)[0] == 0))
    if not (os.environ.get("WAYLAND_DISPLAY") and qs):
        return found, checked
    running = running_shells()
    for name, (where, cmd) in autostarted_shells().items():
        checked += 1
        if name not in running:
            label = SHELL_NAMES.get(name, f"Your Quickshell config \"{name}\"")
            found.append(Problem(f"{label} isn't running (it's started at login by {where}).", start_shell_cmd(name, cmd),
                                 "Starts it again, the way login does (only if it isn't running already).",
                                 verify=lambda name=name: time.sleep(4) or name in running_shells()))
    for name, pid in running.items():
        checked += 1
        errors = shell_log_errors(pid)
        if errors:
            label = SHELL_NAMES.get(name, f"Your Quickshell config \"{name}\"").split(" (")[0]
            found.append(Problem(f"{label} logged that part of it failed to load since it started (pid {pid}): "
                                 + " | ".join(short(e, 140) for e in errors[:3])
                                 + (f" (+{len(errors) - 3} more)" if len(errors) > 3 else "")))
    return found, checked


def hypr_config_problems():
    """Errors Hyprland itself reports in its config (after a Hyprland update, renamed or removed options)."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return [], 0
    rc, out, _ = run(["hyprctl", "configerrors", "-j"], timeout=15)
    try:
        errors = [e.strip() for e in json.loads(out) if isinstance(e, str) and e.strip()] if rc == 0 else []
    except ValueError:
        errors = []
    if not errors:
        return [], 1
    return [Problem("Hyprland reports error(s) in your config, so those settings aren't applied: "
                    + " | ".join(short(e, 160) for e in errors[:4]) + (f" (+{len(errors) - 4} more)" if len(errors) > 4 else ""),
                    verify=lambda: not hypr_config_problems()[0])], 1


def python_imports(text):
    """Top-level modules a Python script imports, except ones inside try/except ImportError (optional)."""
    import ast
    tree = ast.parse(text)
    optional = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Try) and any(
                isinstance(h.type, ast.Name) and h.type.id in ("ImportError", "ModuleNotFoundError")
                or isinstance(h.type, ast.Tuple) and any(getattr(e, "id", "") in ("ImportError", "ModuleNotFoundError") for e in h.type.elts)
                for h in node.handlers):
            optional |= {id(n) for b in node.body for n in ast.walk(b)}
    mods = {}
    for node in ast.walk(tree):
        if id(node) in optional:
            continue
        if isinstance(node, ast.Import):
            for a in node.names:
                mods.setdefault(a.name.split(".")[0], node.lineno)
        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
            mods.setdefault(node.module.split(".")[0], node.lineno)
    return mods


def python_import_problems():
    """Your Python scripts in ~/.local/bin can import what they use (a Python upgrade drops modules
    installed with pip for the old version; a removed package takes its module with it)."""
    found, checked = [], 0
    try:
        scripts = sorted(BIN.iterdir())
    except OSError:
        return [], 0
    for f in scripts:
        if BACKUP_NAME.search(f.name) or not f.is_file() or is_elf(f):
            continue
        try:
            text = f.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        first = text.split("\n", 1)[0]
        if not (first.startswith("#!") and "python" in first):
            continue
        shebang = first[2:].split()
        interp = shebang[1] if len(shebang) > 1 and shebang[0].endswith("/env") else shebang[0]
        try:
            mods = python_imports(text)
        except (SyntaxError, ValueError):
            continue  # script_problems reports the syntax error
        here = f.resolve().parent  # a script symlinked from a repo imports its neighbours there
        mods = {m: line for m, line in mods.items()
                if not (here / f"{m}.py").exists() and not (here / m / "__init__.py").exists()}
        if not mods:
            continue
        checked += 1
        probe = ("import importlib.util,sys\n"
                 "print(' '.join(m for m in sys.argv[1:] if importlib.util.find_spec(m) is None))")
        rc, out, _ = run([interp, "-I", "-c", probe, *mods], timeout=30)
        for m in out.split() if rc == 0 else []:
            found.append(Problem(f"{f.name} (line {mods[m]}) imports the Python module {m}, which isn't installed "
                                 f"for {interp}, so the script stops there."))
    return found, checked


def desktop_entry_problems():
    """App launchers you made (~/.local/share/applications) and things that start at login
    (~/.config/autostart): the program each one runs exists."""
    found, checked = [], 0
    for d in (HOME / ".local/share/applications", HOME / ".config/autostart"):
        for f in sorted(d.glob("*.desktop")):
            try:
                text = f.read_text(errors="replace")
            except OSError:
                continue
            main = text.split("\n[", 1)[0]
            if re.search(r"^Hidden\s*=\s*true", main, re.M | re.I):
                continue
            m = re.search(r"^(TryExec|Exec)\s*=\s*(.+)$", main, re.M)
            if not m:
                continue
            try:
                words = [w for w in shlex.split(m.group(2)) if not re.match(r"^[A-Za-z_]\w*=", w)]
            except ValueError:
                continue
            words = [w for w in words if w not in ("env",)]
            if not words or words[0].startswith("%"):
                continue
            checked += 1
            c = os.path.expanduser(words[0])
            if not command_exists(c):
                pkg = provider(c) if "/" not in c else None
                where = "starts at login" if d.name == "autostart" else "is in your app launcher"
                found.append(Problem(f"{f.name} ({where}) runs {c}, which " + ("isn't installed" if "/" not in c else "doesn't exist")
                                     + (f"; it's in {pkg}: sudo pacman -S {pkg}" if pkg else "") + "."))
    return found, checked


def own_binary_problems():
    """Programs and plugins you built that aren't packages (~/.local/bin, ~/.local/lib): their libraries
    are all still there (an update can remove or rename one; then they need rebuilding)."""
    found, checked = [], 0
    files = []
    for d in (BIN, HOME / ".local/lib"):
        if d.is_dir():
            files += [p for p in d.rglob("*") if p.is_file() and not p.is_symlink() and is_elf(p)]
    for f in files[:200]:
        checked += 1
        missing = ldd_missing([f])
        if missing:
            found.append(Problem(f"{f} needs {describe_missing(missing)}, which is gone (an update removed or renamed it), "
                                 "so it won't start or load until it's rebuilt."))
    return found, checked


def selftest(custom):
    """Is everything this desktop starts and runs actually there? -> (problems, one-line summary)"""
    found, parts = [], []
    for label, (probs, n) in (("startup commands/files in the Hyprland config", startup_problems()),
                              ("service commands", unit_problems()),
                              ("scripts", script_problems()),
                              ("config files", config_problems()),
                              ("Caelestia files/patches", caelestia_copy_problems()),
                              ("shell checks", shell_problems(custom)),
                              ("Hyprland's own config check", hypr_config_problems()),
                              ("Python scripts' imports", python_import_problems()),
                              ("app launchers/autostart entries", desktop_entry_problems()),
                              ("programs/plugins you built", own_binary_problems())):
        found += probs
        if n:
            parts.append(f"{n} {label}")
    summary = "Self-test: checked " + (", ".join(parts) or "nothing")
    return found, summary + (f" — {len(found)} problem{'s' * (len(found) != 1)}." if found else " — everything's there.")


def update_running():
    """pacman/yay is mid-update: files are being swapped, so libraries can look missing for a moment."""
    if Path("/var/lib/pacman/db.lck").exists():
        return True
    rc, _, _ = run(["pgrep", "-x", "pacman|yay|paru|makepkg"], timeout=10)
    return rc == 0


def after_update(full=False):
    """What changed since the last report, and what may have broken. Offline and read-only.
    Without full, the slower checks only run when there's been an update since the last report."""
    log = read_pacman_log()
    changes, upgrades = log or ([], [])
    new = new_changes(changes, upgrades, read_seen())
    notes = [] if log else [f"Couldn't read {PACMAN_LOG}, so updates since boot weren't checked."]
    if update_running():
        notes.insert(0, "An update is running right now, so some of this may be wrong (files are mid-swap). "
                        "Check again when it's finished: update-check --after")
    config, err = load_config()
    entries = [e for e in config.get("custom", []) if isinstance(e, dict)]
    custom = {e["package"]: e for e in entries if e.get("package")}
    problems = reboot_problems(changes) + config_file_problems() + failed_unit_problems()
    journal = None
    if full or new:
        notes += [err] if err and not CONFIG.exists() else []  # a broken config is a self-test problem
        for found, more in (custom_problems(entries, changes), checkrebuild_problems(custom), package_file_problems()):
            problems += found
            notes += more
        journal = journal_summary()
    found, tested = selftest(custom)
    return new, with_causes(one_per_fix(problems + found), changes, new), notes, journal, tested


def with_causes(problems, changes, new):
    """Fill in why each problem appeared, from what changed since the last check that found nothing wrong:
    your files (the history snapshot taken now) and packages (pacman.log)."""
    if not problems:
        return problems
    smart.snapshot("check")
    good_at = smart.tag_time("good")
    files = smart.changed_since()
    pkgs = changes if good_at else new  # no good check yet: only what's new since the last report
    return [p if p.cause else p._replace(cause=smart.explain(p.what, pkgs, files, good_at)) for p in problems]


def all_good(problems):
    """Nothing left but a reboot or news: remember this state as the last one that worked."""
    if not any(p.repairable and p.fix != REBOOT for p in problems):
        smart.mark_good()


def one_per_fix(problems):
    """Two checks can find the same breakage (Quickshell vs Qt, say): one entry per fix, with both findings."""
    out, by_fix = [], {}
    for p in problems:
        if p.fix and p.fix in by_fix:
            i = by_fix[p.fix]
            out[i] = out[i]._replace(what=out[i].what + " Also: " + p.what)
            continue
        if p.fix:
            by_fix[p.fix] = len(out)
        out.append(p)
    return out


def render_problems(problems, outcomes=None):
    """outcomes: {id(problem): what happened when it was fixed automatically}"""
    lines = []
    for p in problems:
        lines.append("  * " + p.what)
        if p.cause:
            lines.append("      why: " + p.cause)
        if p.fix:
            lines.append("      fix: " + p.fix)
        if outcomes and id(p) in outcomes:
            lines.append("      -> " + outcomes[id(p)])
    return lines


def render_changes(new, limit=40):
    if not new:
        return []
    word = {"upgraded": "", "installed": "new ", "removed": "removed ", "reinstalled": "reinstalled ", "downgraded": "DOWNGRADED "}
    lines = [f"== What changed ({len(new)}, {new[0].time.astimezone():%a %d %b %H:%M} – {new[-1].time.astimezone():%a %d %b %H:%M}) =="]
    for c in new[:limit]:
        vers = f"{c.old} -> {c.new}" if c.old and c.new and c.old != c.new else (c.new or c.old)
        lines.append(f"  {word[c.action]}{c.name} {vers}")
    if len(new) > limit:
        lines.append(f"  … and {len(new) - limit} more (all of them: /var/log/pacman.log)")
    return lines + [""]


def after_report(new, problems, notes, journal, tested):
    reboot = any(p.fix == REBOOT for p in problems)
    lines = [f"Post-update check — {datetime.now():%a %d %b %H:%M}"]
    if new:
        lines.append(f"Updated since last check: yes, {len(new)} package change{'s' * (len(new) != 1)} "
                     f"(newest {new[-1].time.astimezone():%a %d %b %H:%M})")
    else:
        lines.append("Updated since last check: no")
    lines.append(f"Reboot needed: {'yes' if reboot else 'no'}")
    lines.append(f"Problems found: {len(problems)}")
    lines.append(tested)
    lines.append("")
    if problems:
        lines.append("== Problems ==")
        lines += render_problems(problems)
        lines.append("")
    if journal or notes:
        lines.append("== Worth knowing ==")
        lines += ["  * " + n for n in notes + ([journal] if journal else [])]
        lines.append("")
    lines += render_changes(new)
    if any(p.fix and p.fix != REBOOT for p in problems):
        lines.append("Fix all of it: update-check --after --fix   (runs each fix and what it needs afterwards, "
                     "then checks again; add --ask to confirm each one)")
    return "\n".join(lines) + "\n"


def needs_terminal(cmd):
    return bool(NEEDS_TERMINAL.search(cmd))


def short(what, n=90):
    return what if len(what) <= n else what[:n - 1].rstrip() + "…"


def execute(cmd, headless):
    """Run a fix: in the terminal you're looking at, or (headless) quietly, logged to FIX_LOG.
    -> (exit code, last line it printed when headless)"""
    if not headless:
        return subprocess.call(cmd, shell=True), ""
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(FIX_LOG, "a") as log:
        log.write(f"\n[{datetime.now():%F %T}] $ {cmd}\n")
        try:
            p = subprocess.run(cmd, shell=True, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=1800)
        except subprocess.TimeoutExpired:
            log.write("(gave up after 30 minutes)\n")
            return 124, "gave up after 30 minutes"
        log.write(p.stdout + p.stderr)
    return p.returncode, ((p.stdout + p.stderr).strip().splitlines() or [""])[-1]


def confirm(prompt):
    try:
        return input(prompt).strip().lower() == "y"
    except EOFError:
        return False


def run_fixes(problems, headless=False, ask=False, say=print):
    """Run every fix, then each follow-up they need (once, and only if its fix worked), then re-check each one.
    Never reboots. headless: only fixes that need no password, rebuild or answers; the rest are returned.
    -> ([(problem, outcome)], [problems left for a terminal])"""
    todo, left = [], []
    for p in problems:
        if not p.fix or p.fix == REBOOT:
            continue
        (left if headless and needs_terminal(p.fix) else todo).append(p)
    results, then = [], []
    for i, p in enumerate(todo, 1):
        say(f"\n[{i}/{len(todo)}] {p.what}")
        if p.why:
            say(f"  What the fix does: {p.why}")
        say(f"  Command: {p.fix}")
        if ask and not confirm("  Run it? [y/N] "):
            results.append((p, "skipped"))
            continue
        rc, last = execute(p.fix, headless)
        if rc != 0:
            results.append((p, f"the fix failed (exit code {rc}{': ' + last if last else ''})"))
            say(f"  It failed (exit code {rc}).")
            continue
        results.append((p, last))
        then += [t for t in p.then if t not in then]
    for t in then:
        if headless and needs_terminal(t):
            continue
        say(f"\nFollow-up: {t}")
        rc, _ = execute(t, headless)
        if rc != 0:
            say(f"  It failed (exit code {rc}).")
    final = []
    for p, outcome in results:
        if outcome == "skipped" or outcome.startswith("the fix failed"):
            final.append((p, outcome))
            continue
        try:
            ok = p.verify() if p.verify else None
        except Exception as e:  # a re-check that breaks shouldn't hide the other results
            ok, outcome = None, f"couldn't re-check ({e})"
        final.append((p, "fixed" if ok else "STILL BROKEN after the fix" if ok is False
                      else "done" + (f" ({outcome})" if outcome else "")))
    if final:
        say("\n== Results ==")
        for p, outcome in final:
            say(f"  {'✓' if outcome == 'fixed' else '•'} {short(p.what)}\n      {outcome}")
    return final, left


def repairable_left(problems, final, left=()):
    """What's still broken after the built-in fixes, for Claude: problems with no fix, and fixes that
    failed or didn't hold. Not reboots, news, or fixes still waiting for a terminal."""
    failed = {id(p): o for p, o in final if o.startswith(("the fix failed", "STILL BROKEN"))}
    waiting = {id(p) for p in left}
    return [{"what": p.what, "cause": p.cause, "tried": p.fix, "outcome": failed.get(id(p))}
            for p in problems if p.repairable and p.fix != REBOOT and id(p) not in waiting
            and (not p.fix or id(p) in failed)]


def _match(text, candidates):
    """The candidate Claude's entry is about (it may reword the problem a little)."""
    import difflib
    best = max(candidates, key=lambda c: difflib.SequenceMatcher(None, text, c).ratio(), default=None)
    return best if best and difflib.SequenceMatcher(None, text, best).ratio() > 0.5 else None


def claude_repair(problems, final, left=(), say=print):
    """Hand what the built-in fixes left to Claude, then check everything again.
    -> (run or None, why there's no run, problems found by the re-check)"""
    todo = repairable_left(problems, final, left)
    if not todo:
        return None, "", problems
    config, _ = load_config()
    changes = (read_pacman_log() or ([], []))[0]
    good_at = smart.tag_time("good")
    since = [c for c in changes if good_at is None or c.time >= good_at][-200:]
    run_, why = smart.ai_fix(todo, since, smart.changed_since(), config,
                             newest_change=changes[-1].time if changes else None, say=say)
    if not run_:
        return None, why, problems
    _, again, _, _, _ = after_update()
    still = [p.what for p in again]
    asked = run_["problems"]
    for entry in run_["fixes"] + run_["needs_you"]:
        entry["about"] = _match(entry["problem"], asked) or entry["problem"]
        entry["gone"] = _match(entry["about"], still) is None
    for entry in run_["fixes"]:
        entry["verified"] = bool(entry.get("fixed")) and entry["gone"]
    (smart.RUNS / f"{run_['id']}.json").write_text(json.dumps(run_, indent=1))
    return run_, "", again


def render_repair(run_):
    """Claude's part of the report: for each problem, why it broke, what was done, and whether it held."""
    lines = []
    for f in run_["fixes"]:
        lines.append(f"  {'✓' if f.get('verified') else '•'} {short(f.get('about') or f['problem'], 160)}")
        lines.append(f"      why it broke: {f['cause']}")
        lines.append(f"      what was done: {f['did']}")
        if f.get("files"):
            lines.append(f"      files changed: {', '.join(f['files'][:6])}")
        lines.append("      result: " + ("fixed, and the re-check confirms it" if f.get("verified")
                                         else "Claude thinks it's fixed, but the re-check still finds it" if f.get("fixed")
                                         else "not fixed"))
    for n in run_["needs_you"]:
        lines.append(f"  ! {short(n.get('about') or n['problem'], 160)}")
        lines.append(f"      why it broke: {n['cause']}")
        lines.append(f"      needs you (a password or a rebuild): {n['command']}")
        lines.append(f"      what that does: {n['why']}")
    if run_.get("error"):
        lines.append(f"  Claude couldn't finish: {short(run_['error'], 300)}")
    if run_["files_changed"]:
        lines.append(f"  Undo everything Claude changed: update-check --undo {run_['id']}")
    return lines


def pending_needs_you(problems):
    """Commands Claude said need you (from its last run, within 2 days) for problems that are still there."""
    runs = sorted(smart.RUNS.glob("*.json")) if smart.RUNS.is_dir() else []
    if not runs:
        return []
    try:
        run_ = json.loads(runs[-1].read_text())
        age = datetime.now() - datetime.fromisoformat(run_["time"])
    except (OSError, ValueError, KeyError):
        return []
    if age.days >= 2:
        return []
    current = [p.what for p in problems]
    return [n for n in run_.get("needs_you", []) if _match(n.get("about") or n["problem"], current)]


def fix_here(problems, ask=False):
    """--fix in a terminal: run everything (sudo asks for your password as usual), then offer the reboot."""
    if not any(p.fix or p.repairable for p in problems):
        print("Nothing to fix.")
        return
    headless = not sys.stdin.isatty()
    print("== Fixing ==", flush=True)
    final, left = run_fixes(problems, headless=headless, ask=ask)
    run_, why, problems = claude_repair(problems, final, left)
    if run_:
        print("\n== What Claude found and did ==")
        print("\n".join(render_repair(run_)))
    elif why:
        print(f"\n(Claude wasn't asked: {why}.)")
    needs = (run_ or {}).get("needs_you") or pending_needs_you(problems)
    if needs and not headless:
        print("\n== These need you ==")
        for n in needs:
            print(f"\n  {n['problem']}\n  Why: {n['cause']}\n  Command: {n['command']}\n  What it does: {n['why']}")
            if confirm("  Run it? [y/N] "):
                subprocess.call(n["command"], shell=True)
    if left:
        print(f"\n{len(left)} fix(es) need a terminal (a password, a rebuild or questions). Run: update-check --after --fix")
    if any(p.fix == REBOOT for p in problems) and not headless and confirm("\nA reboot is still needed. Reboot now? [y/N] "):
        subprocess.call(REBOOT, shell=True)


def after(do_fix, ask=False, pause=False):
    print("Checking what changed and what may have broken (offline)…", flush=True)
    new, problems, notes, journal, tested = after_update(full=True)
    print("\n" + after_report(new, problems, notes, journal, tested))
    mark_seen(new)
    all_good(problems)
    if do_fix:
        fix_here(problems, ask)
        all_good(after_update()[1])
    if pause:
        confirm("\nDone. Press Enter to close.")


def fullscreen():
    """Is a fullscreen window (a game, a video) in front right now?"""
    rc, out, _ = run(["hyprctl", "activewindow", "-j"], timeout=10)
    try:
        return rc == 0 and bool(json.loads(out or "{}").get("fullscreen"))
    except ValueError:
        return False


def open_fix_terminal():
    subprocess.Popen(["kitty", "--class", "update-check", "-T", "Fixing", "-e", str(BIN / "update-check"),
                      "--after", "--fix", "--pause"], start_new_session=True)


def fix_later():
    """--fix-later: open the fix terminal once nothing is fullscreen (a terminal behind a game would sit
    there waiting for your password unseen). Gives up after 12 hours; the next check finds it all again."""
    deadline = time.time() + 12 * 3600
    while fullscreen():
        if time.time() > deadline:
            return
        time.sleep(30)
    open_fix_terminal()


def auto_fix(problems):
    """Background (login / 7:00): run the fixes that need nothing from you; hand the rest to a terminal,
    opened now, or once you leave fullscreen. -> ({id(problem): outcome}, problems handed to the terminal)"""
    final, left = run_fixes(problems, headless=True, say=lambda *a: None)
    run_, _, _ = claude_repair(problems, final, left, say=lambda *a: None)
    if run_:
        for p in problems:
            hit = next((f for f in run_["fixes"] if f.get("about") == p.what), None)
            if hit and hit.get("verified"):
                final = [(q, o) for q, o in final if q is not p] + [(p, "fixed by Claude: " + short(hit["did"], 200))]
        left = left + [p for p in problems if p not in left and any(n.get("about") == p.what for n in run_["needs_you"])]
    where = "a terminal opened for it"
    if left and fullscreen():
        subprocess.Popen([str(BIN / "update-check"), "--fix-later"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        where = "a terminal opens for it once you leave fullscreen"
    elif left:
        open_fix_terminal()
    outcomes = {id(p): o for p, o in final}
    for p in left:
        outcomes[id(p)] = f"needs your password, a rebuild or answers: {where}"
    return outcomes, left, run_


def build_report(wait, autofix=False):
    lines, todo = [], []
    stamp = datetime.now().strftime("%a %d %b %H:%M")
    if not online(wait):
        return f"Update check — {stamp}\n\nNo internet, so nothing was checked.", "offline", "", [], []

    _, out, _ = run(["pacman", "-Qq"])
    installed = set(out.split())
    repo, repo_err = repo_updates()
    aur, flat = aur_updates(), flatpak_updates()
    since = last_full_upgrade()
    news, news_err = news_since(since, installed)
    new, problems, notes, journal, tested = after_update()
    problems = one_per_fix(problems + health())
    fixed, outcomes, handed, repair = [], {}, [], None
    if autofix and any((p.fix and p.fix != REBOOT) or p.repairable for p in problems):
        outcomes, handed, repair = auto_fix(problems)
        done = {i for i, o in outcomes.items() if o == "fixed" or o.startswith(("done", "fixed by Claude"))}
        fixed = [p for p in problems if id(p) in done]
        problems = [p for p in problems if id(p) not in done]

    ignored = [l for l in repo or [] if "[ignored]" in l]
    repo = [l for l in repo or [] if "[ignored]" not in l]
    names = [l.split()[0] for l in repo + aur]
    n = len(repo) + len(aur) + len(flat)

    lines.append(f"Update check — {stamp}")
    if since:
        days = (datetime.now(since.tzinfo) - since).days
        lines.append(f"Last full update: {since:%a %d %b %Y} ({days} day{'s' * (days != 1)} ago)")
    lines.append(tested)
    lines.append("")

    if news:
        lines.append(f"== Arch news since your last update ({len(news)}) — READ BEFORE UPDATING ==")
        for date, title, link, text, mine in news:
            lines.append(f"* {date:%d %b}: {title}")
            if mine:
                lines.append(f"  Affects packages you have: {', '.join(mine[:8])}")
            lines.append("  " + (text[:600] + ("…" if len(text) > 600 else "")))
            lines.append(f"  {link}")
            lines.append("")
        todo.append("Read the Arch news above first; follow any manual steps it gives.")
    elif news_err:
        lines.append(f"(Couldn't fetch Arch news: {news_err})\n")

    if repo_err:
        lines.append(f"(Couldn't check official repos: {' '.join(repo_err)})")
    for title, pk in (("Official repos", repo), ("AUR", aur), ("Flatpak", flat)):
        if pk:
            lines.append(f"== {title}: {len(pk)} update{'s' * (len(pk) != 1)} ==")
            lines += ["  " + p for p in pk]
            lines.append("")
    if ignored:
        lines.append("Held back on purpose (IgnorePkg in /etc/pacman.conf, kept in step with the top bar):")
        lines += ["  " + p for p in ignored]
        lines.append("")

    for pattern, advice in ADVICE:
        hit = [p for p in names if re.search(pattern, p)]
        if hit:
            todo.append(f"{advice}  [{', '.join(hit[:6])}{', …' if len(hit) > 6 else ''}]")
    if problems:
        lines.append("== Needs attention now ==")
        lines += render_problems(problems, outcomes)
        lines.append("")
    if fixed:
        lines.append("== Fixed automatically ==")
        for p in fixed:
            lines.append(f"  * {p.what}")
            if p.cause:
                lines.append(f"      why it broke: {p.cause}")
            if p.why and not outcomes[id(p)].startswith("fixed by Claude"):
                lines.append(f"      what was done: {p.why} ({p.fix})")
            lines.append(f"      -> {outcomes[id(p)]}")
        lines.append(f"  (what the fixes printed: {FIX_LOG})")
        lines.append("")
    if repair:
        lines.append("== What Claude found and did ==")
        lines += render_repair(repair)
        lines.append("")
    if new:
        lines.append(f"== Since your last update ({len(new)} package change{'s' * (len(new) != 1)}) ==")
        lines += ["  * " + t for t in ([journal] if journal else []) + notes]
        lines.append("")
        lines += render_changes(new, limit=15)

    if n:
        todo.insert(0 if not news else 1, "Run: arch-update   (updates repos + AUR and rebuilds what this desktop needs)")
    if flat:
        todo.append("Flatpaks: flatpak update")
    if any(p.fix and p.fix != REBOOT and p not in handed for p in problems):
        todo.append("Fix the problems above (each fix, its follow-ups, then a re-check): update-check --after --fix")
    if since and n and (datetime.now(since.tzinfo) - since).days > 30:
        todo.append("It's been over a month: update soon, Arch gets harder to update the longer you wait.")

    if todo:
        lines.append("== What to do ==")
        lines += [f"  {i}. {t}" for i, t in enumerate(todo, 1)]
    if not n and not problems and not news:
        lines.append("Everything is up to date. Nothing to do.")

    # headline + body for the notification
    if not n and not problems and not news and not fixed:
        level, head, body = "ok", "System up to date", "No updates, no news, nothing broken."
    else:
        parts = []
        if n:
            parts.append(f"{n} update{'s' * (n != 1)}")
        if news:
            parts.append(f"{len(news)} Arch news post{'s' * (len(news) != 1)} to read first")
        if problems:
            parts.append(f"{len(problems)} thing{'s' * (len(problems) != 1)} need attention")
        if new:
            parts.insert(0, f"updated {len(new)} package{'s' * (len(new) != 1)} since last check")
        if fixed:
            by_claude = sum(1 for p in fixed if outcomes[id(p)].startswith("fixed by Claude"))
            parts.append(f"fixed {len(fixed)} problem{'s' * (len(fixed) != 1)} automatically"
                         + (f" ({by_claude} by Claude)" if by_claude else ""))
        if handed:
            parts.append(f"{len(handed)} fix{'es' * (len(handed) != 1)} need{'s' * (len(handed) == 1)} your password: "
                         + outcomes[id(handed[0])].split(": ", 1)[1].replace(" for it", ""))
        level = "important" if news or problems else "updates"
        head = "Updates available" if n else "System needs attention" if problems else "Fixed automatically"
        body = ", ".join(parts) + "."
        extra = [p.what.split(":")[0] + "." for p in problems if p.fix == REBOOT]
        extra += [t for t in todo if "Reboot" in t or "caelestia-patch" in t or "Qt changes" in t]
        if extra:
            body += "\n" + extra[0].split("  [")[0]
    if not n and not problems and not news and new:
        body = f"Updated {len(new)} package{'s' * (len(new) != 1)} since last check; nothing looks broken."
    undo_id = repair["id"] if repair and repair["files_changed"] else None
    return "\n".join(lines) + "\n", level, (head, body, undo_id), new, problems


def show():
    try:
        print(REPORT.read_text())
    except OSError:
        print("No report yet. Run: update-check")
        return
    offer_update()


def offer_update():
    if not sys.stdin.isatty():
        return
    try:
        ans = input("Run arch-update now? [y/N] ").strip().lower()
    except EOFError:
        return
    if ans == "y":
        subprocess.call([str(BIN / "arch-update")])
        input("\nDone. Press Enter to close.")


def locked():
    _, out, _ = run(["qs", "-c", "caelestia", "ipc", "call", "lock", "isLocked"], timeout=10)
    return out.strip() == "true"


def daily():
    today = datetime.now().date().isoformat()
    try:
        if LAST_RUN.read_text().strip() == today:
            return
    except OSError:
        pass
    # Woken at 7:00 or straight out of suspend: wait until you've unlocked, so the
    # notification isn't lost behind the lock screen (give up after 12 hours).
    deadline = time.time() + 12 * 3600
    while locked():
        if time.time() > deadline:
            return
        time.sleep(15)
    time.sleep(10)  # Wi-Fi reconnecting after resume
    login(delay=0, detach=True)


WAITER = CACHE / "waiter.pid"  # the check whose notification is waiting for a click


def replace_waiter():
    """Only the newest notification waits for a click. An older waiter is out of date, and it may never
    return: its notification is lost if the shell restarts, and its 24 h timeout doesn't count time asleep."""
    try:
        old = int(WAITER.read_text())
        cmdline = Path(f"/proc/{old}/cmdline").read_bytes()
    except (OSError, ValueError):
        old, cmdline = None, b""
    if old and old != os.getpid() and b"update-check" in cmdline:
        for child in run(["pgrep", "-P", str(old)], timeout=10)[1].split():
            try:
                os.kill(int(child), 15)  # its notify-send
            except (ProcessLookupError, ValueError):
                pass
        try:
            os.kill(old, 15)
        except ProcessLookupError:
            pass
    CACHE.mkdir(parents=True, exist_ok=True)
    WAITER.write_text(str(os.getpid()))


def login(delay=20, detach=False):
    time.sleep(delay)  # let the shell's notification server and the network come up first
    report, level, msg, new, problems = build_report(wait=300, autofix=True)
    CACHE.mkdir(parents=True, exist_ok=True)
    if level != "offline":
        LAST_RUN.write_text(datetime.now().date().isoformat() + "\n")
    REPORT.write_text(report)
    mark_seen(new)
    if level == "offline":
        return
    all_good(problems)
    # The notification can sit unanswered all day; under the timer, let a child wait for
    # the click so the service finishes and tomorrow's 7:00 run isn't blocked.
    if detach and os.fork() > 0:
        os._exit(0)
    head, body, undo_id = msg
    replace_waiter()
    cmd = ["notify-send", "-a", "Update check", "-i", "system-software-update", head, body]
    if level == "ok":
        subprocess.call(cmd + ["-t", "6000"])
        return
    cmd += ["-u", "critical" if level == "important" else "normal",
            "-A", "details=Show details", "-A", "update=Update now"]
    if undo_id:
        cmd += ["-A", "undo=Undo Claude's changes"]
    _, out, _ = run(cmd, timeout=24 * 3600)
    if out.strip() == "undo":
        _, done = smart.undo(undo_id)
        subprocess.call(["notify-send", "-a", "Update check", "-i", "edit-undo", "Undid Claude's changes",
                         "\n".join(done[:6])])
    elif out.strip() in ("details", "update"):
        subprocess.Popen(["kitty", "--class", "update-check", "-T", "Update check",
                          "-e", str(BIN / "update-check"), "--show"], start_new_session=True)


def history(args):
    """--history: recent snapshots; --history PATH: that file's versions; --history REV PATH: print one."""
    if not smart.ensure_repo() or not smart.head():
        print("No history yet (the first snapshot is taken at the next check or update).")
        return
    if not args:
        _, out = smart.git("log", "--format=%h %cd  %s%d", "--date=format:%a %d %b %H:%M", "-n", "30")
        print(out.rstrip() or "No snapshots yet.")
        print("\nOne file's versions: update-check --history ~/.config/hypr/hyprland.lua")
        return
    path = os.path.relpath(os.path.abspath(os.path.expanduser(args[-1])), HOME)
    if len(args) == 1:
        print(smart.history_log(path).rstrip() or f"No saved versions of ~/{path}.")
        print(f"\nPrint one: update-check --history REV ~/{path}    Put one back: update-check --restore ~/{path} REV")
    else:
        sys.stdout.write(smart.history_show(args[0], path))


def restore(args):
    """--restore PATH [REV]: put a file back as it was in a snapshot (default: the last check that found
    nothing wrong). The current version is snapshotted first, so this can be undone the same way."""
    if not args:
        sys.exit("Which file? update-check --restore ~/.config/hypr/hyprland.lua [REV]")
    path = os.path.relpath(os.path.abspath(os.path.expanduser(args[0])), HOME)
    rev = args[1] if len(args) > 1 else "good"
    if smart.git("cat-file", "-e", f"{rev}:{path}")[0] != 0:
        sys.exit(f"There's no saved version of ~/{path} at {rev}. Its versions: update-check --history ~/{path}")
    before = smart.snapshot(f"before restoring {path} from {rev}")
    smart.git("checkout", rev, "--", path)
    smart.snapshot(f"restored {path} from {rev}")
    print(f"Put back ~/{path} as it was at {rev}. The version you had is saved too ({before[:8]}): "
          f"update-check --restore ~/{path} {before[:8]}")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--login":
        login()
    elif arg == "--daily":
        daily()
    elif arg == "--show":
        show()
    elif arg == "--after":
        flags = sys.argv[2:]
        after(do_fix="--fix" in flags, ask="--ask" in flags, pause="--pause" in flags)
    elif arg == "--fix-later":
        fix_later()
    elif arg == "--snapshot":
        smart.snapshot(" ".join(sys.argv[2:]) or "snapshot", tag="before-update" if "update" in " ".join(sys.argv[2:]) else None)
    elif arg == "--history":
        history(sys.argv[2:])
    elif arg == "--restore":
        restore(sys.argv[2:])
    elif arg == "--undo":
        run_id, done = smart.undo(sys.argv[2] if len(sys.argv) > 2 else None)
        print((f"Fix run {run_id}:\n  " if run_id else "") + "\n  ".join(done))
    elif arg == "--selftest":
        config, _ = load_config()
        custom = {e["package"]: e for e in config.get("custom", []) if isinstance(e, dict) and e.get("package")}
        problems, tested = selftest(custom)
        print(tested)
        print("\n".join(render_problems(problems)))
        if "--fix" in sys.argv[2:]:
            fix_here(problems, ask="--ask" in sys.argv[2:])
    elif arg in ("-h", "--help"):
        print(__doc__.strip())
    elif arg == "":
        print("Checking (repos, AUR, Flatpak, Arch news, system health)…", flush=True)
        report, _, _, new, problems = build_report(wait=15)
        CACHE.mkdir(parents=True, exist_ok=True)
        REPORT.write_text(report)
        mark_seen(new)
        print("\n" + report)
        if any(p.fix and p.fix != REBOOT for p in problems):
            fix_here(problems)
        offer_update()
    else:
        sys.exit(f"Unknown option {arg} (try: update-check --help)")


if __name__ == "__main__":
    main()
