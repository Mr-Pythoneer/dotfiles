def parse_time(s):
    try:
        t = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.astimezone()  # old pacman logs: local time, no offset


def parse_pacman_log(lines):
    """pacman.log -> (package changes, start times of full system upgrades), oldest first."""
    changes, upgrades = [], []
    for line in lines:
        m = ALPM_LINE.match(line)
        t = m and parse_time(m.group(1))
        if t:
            action, vers = m.group(2), m.group(4).split(" -> ")
            if len(vers) == 2:
                old, new = vers
            elif action == "installed":
                old, new = "", vers[0]
            elif action == "removed":
                old, new = vers[0], ""
            else:
                old = new = vers[0]
            changes.append(Change(t, action, m.group(3), old, new))
            continue
        m = FULL_UPGRADE.match(line)
        t = m and parse_time(m.group(1))
        if t:
            upgrades.append(t)
    return changes, upgrades


def read_pacman_log():
    try:
        with open(PACMAN_LOG, errors="replace") as f:
            return parse_pacman_log(f)
    except OSError:
        return None


def new_changes(changes, upgrades, seen):
    """Changes after `seen` (the newest one already reported). Never reported before: the last
    full system upgrade, plus anything after it (rebuilds arch-update installs with makepkg)."""
    if seen is None:
        starts = [u for u in upgrades if changes and u <= changes[-1].time]
        return [c for c in changes if c.time >= starts[-1]] if starts else []
    return [c for c in changes if c.time > seen]


def read_seen():
    try:
        return parse_time(LAST_SEEN.read_text().strip())
    except OSError:
        return None


def mark_seen(new):
    if new:
        STATE.mkdir(parents=True, exist_ok=True)
        LAST_SEEN.write_text(max(c.time for c in new).isoformat() + "\n")


def kernel_package(release):
    """uname -r -> the package it came from: 7.2.8-arch1-2 -> linux, 6.12.50-1-lts -> linux-lts."""
    flavour = release.rsplit("-", 1)[-1]
    return f"linux-{flavour}" if flavour in KERNEL_FLAVOURS else "linux"


def kernel_release(pkg, version):
    """Package version -> the uname -r it boots as: linux 7.2.8.arch1-2 -> 7.2.8-arch1-2,
    linux-lts 6.12.50-1 -> 6.12.50-1-lts."""
    return re.sub(r"\.(?=[a-z])", "-", version, count=1) + pkg[len("linux"):]


def reboot_reasons(running, kernels, changes, booted):
    """Why a reboot is needed (empty: it isn't).
    running: uname -r; kernels: installed kernel package -> version; booted: boot time or None."""
    reasons = []
    pkg = kernel_package(running)
    if pkg in kernels and kernel_release(pkg, kernels[pkg]) != running:
        reasons.append(f"running kernel {running}, but {pkg} {kernels[pkg]} is installed")
    if booted:
        for pattern, what in REBOOT_PKGS:
            hit = sorted({c.name for c in changes if c.time > booted and c.action != "removed" and re.search(pattern, c.name)})
            if hit:
                reasons.append(f"{what} updated since boot: {', '.join(hit[:6])}{', …' if len(hit) > 6 else ''}")
    return reasons


def boot_time():
    try:
        line = next(l for l in Path("/proc/stat").read_text().splitlines() if l.startswith("btime "))
        return datetime.fromtimestamp(int(line.split()[1]), timezone.utc)
    except (OSError, StopIteration, ValueError):
        return None


def pkg_date(pkg, field):
    """A date from pacman -Qi ("Install Date", "Build Date"), or None."""
    _, out, _ = run(["pacman", "-Qi", pkg], env={**os.environ, "LC_ALL": "C"})
    m = re.search(rf"^{field}\s*:\s*(.+)$", out, re.M)
    if not m:
        return None
    _, ts, _ = run(["date", "-d", m.group(1).strip(), "+%s"])
    return datetime.fromtimestamp(int(ts), timezone.utc) if ts.strip().isdigit() else None


def reboot_problems(changes):
    running = os.uname().release
    kernels = {}
    for pkg in {"linux", "linux-lts", kernel_package(running)}:
        rc, out, _ = run(["pacman", "-Q", pkg])
        if rc == 0 and len(out.split()) == 2:
            kernels[pkg] = out.split()[1]
    reasons = reboot_reasons(running, kernels, changes, boot_time())
    if not reasons:
        return []
    return [Problem("Reboot needed: " + "; ".join(reasons) + ".", REBOOT,
                    "Restarts the computer so the new kernel and libraries are the ones running "
                    "(until then USB, sound or Wi-Fi modules may fail to load). Save your work first.")]


def config_file_problems():
    _, out, _ = run(["find", "/etc", "-name", "*.pacnew", "-o", "-name", "*.pacsave"], timeout=30)
    files = [l for l in out.splitlines() if l.strip()]
    if not files:
        return []
    what = f"{len(files)} config file(s) from updates waiting to be merged: " + ", ".join(files)
    if not shutil.which("pacdiff"):
        return [Problem(what + "  (the usual tool for this, pacdiff, is in pacman-contrib: sudo pacman -S pacman-contrib)")]
    return [Problem(what, "sudo DIFFPROG='nvim -d' pacdiff",
                    "Goes through each .pacnew/.pacsave file and asks what to do: view the differences, "
                    "merge them, or keep yours. Nothing changes unless you choose it there.",
                    verify=lambda: not config_file_problems())]


def failed_unit_problems():
    found = []
    for scope in ([], ["--user"]):
        rc, out, err = run(["systemctl", *scope, "--failed", "--no-legend", "--plain"])
        if rc != 0 and not out:
            continue  # no systemd user instance (e.g. under sudo): nothing to report
        for unit in (l.split()[0] for l in out.splitlines() if l.strip()):
            if HARMLESS_UNITS.match(unit):
                continue
            sc = "systemctl --user" if scope else "systemctl"
            found.append(Problem(f"{'Your' if scope else 'System'} service failed: {unit}  (why: {sc} status {unit})",
                                 f"{sc} restart {unit}" if scope else f"sudo {sc} restart {unit}",
                                 f"Starts it again. If it fails again, the reason is in: journalctl {'--user ' if scope else ''}-b -u {unit}",
                                 verify=lambda scope=scope, unit=unit: run(["systemctl", *scope, "is-failed", "--quiet", unit])[0] != 0))
    return found


def journal_summary():
    """One line: how many error-level messages this boot, and from what."""
    rc, out, err = run(["journalctl", "-b", "-p", "err", "-q", "--no-pager", "-o", "json",
                        "--output-fields=SYSLOG_IDENTIFIER,_COMM,MESSAGE"], timeout=60)
    if rc != 0 and not out:
        return f"Journal: couldn't read it ({(err.strip().splitlines() or ['journalctl failed'])[-1]})"
    counts, sample = Counter(), {}
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        who = e.get("SYSLOG_IDENTIFIER") or e.get("_COMM") or "?"
        counts[who] += 1
        msg = e.get("MESSAGE")
        sample.setdefault(who, " ".join(msg.split()) if isinstance(msg, str) else "(binary message)")
    if not counts:
        return "Journal: no error messages since boot."
    top = "; ".join(f"{who} {n} (e.g. \"{sample[who][:70]}\")" for who, n in counts.most_common(4))
    text = f"Journal: {sum(counts.values())} error messages since boot — {top}. All of them: journalctl -b -p err"
    if "not seeing messages" in err:
        text += " (only your own: you can't read the system journal)"
    return text


def is_prebuilt(pkg):
    """-bin packages repackage upstream's binaries: rebuilding one changes nothing, only a newer release can."""
    return pkg.endswith("-bin")


def newer_version_cmd(pkg):
    """Read-only: does the AUR have a newer version of pkg? (needs internet, installs nothing)"""
    q = shlex.quote(pkg)
    return f"yay -Qua | awk -v p={q} '$1 == p {{print; f=1}} END {{if (!f) print \"No newer \" p \" in the AUR yet.\"}}'"


def newer_version_why(pkg):
    return (f"Asks the AUR whether a newer {pkg} is out (needs internet; installs nothing). {pkg} ships prebuilt "
            "binaries, so rebuilding it would only repackage the same files. If a newer version is listed, update "
            "(arch-update); if not, its maintainer has to catch up: see the comments on its AUR page.")


def rebuild_cmd(pkg, custom):
    return custom.get(pkg, {}).get("rebuild") or f"yay -S --rebuild {pkg}"


def ldd_missing(paths, own=frozenset()):
    """Libraries ldd can't find: {library: first file that needs it}.
    own: names of files that ship alongside. Those aren't missing, just not where ldd looks: e.g. Zen's
    DRM plugin in gmp-clearkey/0.1/ needs libmozsqlite3.so, which is two folders up and already loaded
    by the browser when it loads the plugin."""
    missing = {}
    for f in paths:
        _, out, _ = run(["ldd", str(f)], timeout=30)
        for lib in re.findall(r"^\s*(\S+) => not found", out, re.M):
            if lib not in own:
                missing.setdefault(lib, str(f))
    return missing


def describe_missing(missing):
    return ", ".join(f"{lib} (needed by {f})" for lib, f in sorted(missing.items()))


def package_files(pkg):
    _, out, _ = run(["pacman", "-Qlq", pkg])
    return [Path(l) for l in out.splitlines() if l and not l.endswith("/")]


def elf_files(files):
    return [f for f in files if f.is_file() and not f.is_symlink() and is_elf(f)]


def package_elves(pkg):
    return elf_files(package_files(pkg))


def missing_libs(pkg):
    """-> (libraries pkg really lacks, True if ldd only lacks ones pkg ships itself)"""
    files = package_files(pkg)
    found = ldd_missing(elf_files(files))
    real = {lib: f for lib, f in found.items() if lib not in {f.name for f in files}}
    return real, bool(found) and not real


def checkrebuild_problems(custom):
    """custom: your own builds from the config, package name -> its entry."""
    if not shutil.which("checkrebuild"):
        return [], ["checkrebuild isn't installed, so packages needing a rebuild after a library update weren't checked "
                    "(it's in rebuild-detector: sudo pacman -S rebuild-detector)"]
    rc, out, err = run(["checkrebuild"], timeout=600)
    if rc != 0 and not out:
        return [], [f"checkrebuild failed: {(err.strip().splitlines() or ['no output'])[-1]}"]
    found, notes = [], []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        repo, pkg = parts[0], parts[1]
        missing, shipped_only = missing_libs(pkg)
        if shipped_only:
            notes.append(f"checkrebuild flags {pkg}, but the only libraries it can't find ship with {pkg} itself "
                         "(the app loads them before the part that needs them), so that's fine.")
            continue
        if repo == "foreign" and is_prebuilt(pkg) and pkg not in custom:
            found.append(Problem(f"{pkg} (prebuilt, AUR) " + (f"is missing {describe_missing(missing)}." if missing else
                                 "is linked to a library version that's gone (checkrebuild), though ldd finds nothing "
                                 "missing; it may only fail when that part is used."),
                                 newer_version_cmd(pkg), newer_version_why(pkg)))
        elif repo == "foreign":
            found.append(Problem(f"{pkg} (AUR / self-built) is linked to a library version that's gone: needs a rebuild.",
                                 rebuild_cmd(pkg, custom), f"Rebuilds {pkg} against the libraries now installed.",
                                 tuple(custom.get(pkg, {}).get("after", ())),
                                 lambda pkg=pkg: not missing_libs(pkg)[0]))
        else:
            found.append(Problem(f"{pkg} (from [{repo}]) is linked to a library version that's gone. Arch usually ships "
                                 "a rebuild within days; if it's still here after the next update, report it on the Arch bug tracker."))
    return found, notes


def is_elf(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"\x7fELF"
    except OSError:
        return False


def load_config():
    try:
        with open(CONFIG, "rb") as f:
            return tomllib.load(f), None
    except FileNotFoundError:
        return {}, f"No {CONFIG}, so your own builds weren't checked (example: {CONFIG_EXAMPLE})"
    except (OSError, tomllib.TOMLDecodeError) as e:
        return {}, f"Couldn't read {CONFIG}: {e}"


def qt_arrived(changes):
    """When the installed qt6-base version arrived (pacman.log, else pacman -Qi), or None."""
    for c in reversed(changes):
        if c.name == "qt6-base" and c.action in ("upgraded", "downgraded", "installed"):
            return c.time
    return pkg_date("qt6-base", "Install Date")


def custom_problems(entries, changes):
    """Your own builds: missing shared libraries, built against an older Qt than the one installed."""
    found, notes = [], []
    rc, out, _ = run(["pacman", "-Q", "qt6-base"])
    qt = out.split()[1].split("-")[0] if rc == 0 and len(out.split()) == 2 else None
    qt_minor = int(qt.split(".")[1]) if qt and qt.count(".") >= 1 and qt.split(".")[1].isdigit() else None
    qt_since = qt_arrived(changes) if qt else None
    if not shutil.which("readelf"):
        notes.append("readelf isn't installed, so Qt versions weren't checked (it's in binutils)")
    for e in entries:
        if not isinstance(e, dict):
            continue
        pkg = e.get("package")
        files = [Path(os.path.expanduser(f)) for f in e.get("files", [])]
        name = e.get("name") or pkg or ", ".join(map(str, files))
        fix = e.get("rebuild") or (f"yay -S --rebuild {pkg}" if pkg else None)
        why = f"Rebuilds {name} against the libraries now installed."
        if pkg and is_prebuilt(pkg) and not e.get("rebuild"):  # an explicit rebuild in the config still wins
            fix, why = newer_version_cmd(pkg), newer_version_why(pkg)
        then = tuple(e.get("after", ()))
        verify = lambda e=e: not custom_problems([e], changes)[0]

        def problem(what):
            return Problem(what, fix, why, then, verify)

        built = None
        if pkg:
            rc, out, _ = run(["pacman", "-Qlq", pkg])
            if rc != 0:
                notes.append(f"{pkg} is listed in {CONFIG} but isn't installed")
                continue
            files += [Path(l) for l in out.splitlines() if l and not l.endswith("/")]
            built = pkg_date(pkg, "Build Date")
        gone = [str(f) for f in files if not f.exists()]
        if gone and not pkg:
            found.append(problem(f"{name} is missing: {', '.join(gone)}"))
            continue
        elves = [f for f in files if f.is_file() and not f.is_symlink() and is_elf(f)]
        if not pkg and elves:
            built = datetime.fromtimestamp(max(f.stat().st_mtime for f in elves), timezone.utc)
        missing, uses_qt, private, needs_minor = ldd_missing(elves, {f.name for f in files}), False, False, 0
        for f in elves:
            _, out, _ = run(["ldd", str(f)], timeout=30)
            uses_qt |= "libQt6" in out
            if shutil.which("readelf"):
                _, out, _ = run(["readelf", "-V", "--wide", str(f)], timeout=30)
                private |= "Qt_6_PRIVATE_API" in out
                needs_minor = max([needs_minor, *map(int, re.findall(r"\bQt_6\.(\d+)\b", out))])
        if missing:
            found.append(problem(f"{name} can't load: missing {describe_missing(missing)}"))
        if e.get("check") and subprocess.call(e["check"], shell=True, stdin=subprocess.DEVNULL,
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            found.append(problem(f"{name}: its check failed ({e['check']})"))
        if not uses_qt or not qt:
            continue
        if qt_minor is not None and needs_minor > qt_minor:
            found.append(problem(f"{name} needs Qt 6.{needs_minor}, but Qt {qt} is installed."))
        elif built and qt_since and built < qt_since:
            older = f"{name} was built {built.astimezone():%d %b}, before Qt {qt} arrived ({qt_since.astimezone():%d %b})"
            if private:
                found.append(problem(older + ", and it uses Qt's private API, so it will probably crash or not start."))
            else:
                notes.append(older + "; it only uses Qt's public API, so it should keep working (rebuild if it misbehaves: "
                             + (fix or "rebuild it") + ")")
    return found, notes


def reinstall_problems(pkgs):
    """How to put back missing files without ever downgrading: reinstall only the exact installed version."""
    found, same = [], []
    for pkg in pkgs:
        verify = lambda pkg=pkg: not missing_package_files([pkg])[0]
        _, local, _ = run(["pacman", "-Q", pkg])
        _, sync, _ = run(["pacman", "-Si", pkg], env={**os.environ, "LC_ALL": "C"})
        local = local.split()[1] if len(local.split()) == 2 else ""
        m = re.search(r"^Version\s*:\s*(\S+)", sync, re.M)
        if m and m.group(1) == local:
            same.append(pkg)
            continue
        cached = sorted(glob.glob(f"/var/cache/pacman/pkg/{glob.escape(pkg)}-{glob.escape(local)}-*.pkg.tar.*"))
        cached = [c for c in cached if not c.endswith(".sig")]
        if cached:
            found.append(Problem(f"{pkg} {local} has missing files.", f"sudo pacman -U {cached[0]}",
                                 f"Reinstalls {pkg} {local} from pacman's cache (the same version, so nothing is downgraded).", verify=verify))
        elif not m and is_prebuilt(pkg):
            # yay keeps what it built; reinstalling that exact file puts the binaries back as they were
            built = [c for c in sorted(glob.glob(str(HOME / f".cache/yay/{glob.escape(pkg)}/{glob.escape(pkg)}-{glob.escape(local)}-*.pkg.tar.*")))
                     if not c.endswith(".sig")]
            if built:
                found.append(Problem(f"{pkg} {local} has missing files.", f"sudo pacman -U {built[0]}",
                                     f"Reinstalls {pkg} {local} from yay's cache (the same version, so nothing is downgraded).", verify=verify))
            else:
                found.append(Problem(f"{pkg} {local} (prebuilt, AUR) has missing files and yay's cache doesn't have it.",
                                     newer_version_cmd(pkg), newer_version_why(pkg)))
        elif not m:
            found.append(Problem(f"{pkg} {local} has missing files (AUR / self-built).", f"yay -S --rebuild {pkg}",
                                 f"Rebuilds and reinstalls {pkg}.", verify=verify))
        else:
            found.append(Problem(f"{pkg} {local} has missing files. The repos have {m.group(1)} and the cache doesn't have "
                                 f"{local}, so update first (arch-update); that reinstalls it."))
    if same:
        found.insert(0, Problem(f"Packages with missing files: {', '.join(same)}", f"sudo pacman -S {' '.join(same)}",
                                "Reinstalls them (the same version the repos have, so nothing is downgraded).",
                                verify=lambda: not missing_package_files(same)[0]))
    return found


def missing_package_files(pkgs=()):
    """pacman -Qkq -> ({package: [missing files]}, files that couldn't be checked, error or None)."""
    rc, out, err = run(["pacman", "-Qkq", *pkgs], timeout=300)
    if rc != 0 and not out and err.strip():
        return {}, 0, (err.strip().splitlines() or ["no output"])[-1]
    broken, unreadable = {}, 0
    for line in out.splitlines():
        pkg, _, path = line.partition(" ")
        try:
            os.lstat(path)
        except FileNotFoundError:
            broken.setdefault(pkg, []).append(path)
        except OSError:
            unreadable += 1  # e.g. /boot is root-only: pacman can't see the file, it isn't missing
    return broken, unreadable, None


def package_file_problems():
    broken, unreadable, err = missing_package_files()
    if err:
        return [], [f"pacman -Qkq failed: {err}"]
    notes = [f"{unreadable} package file(s) couldn't be checked without root (e.g. under /boot); that's normal"] if unreadable else []
    if not broken:
        return [], notes
    detail = "; ".join(f"{p}: {len(f)} file(s), e.g. {f[0]}" for p, f in sorted(broken.items())[:6])
    return [Problem("Package files are missing — " + detail)] + reinstall_problems(sorted(broken)), notes


