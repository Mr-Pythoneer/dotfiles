# [2026-10-09T21:08:32-0400] [ALPM] upgraded qt6-base (6.11.1-1 -> 6.11.2-3)
ALPM_LINE = re.compile(r"^\[([^\]]+)\] \[ALPM\] (upgraded|downgraded|installed|reinstalled|removed) (\S+) \(([^)]*)\)")
FULL_UPGRADE = re.compile(r"^\[([^\]]+)\] \[PACMAN\] starting full system upgrade")
# Updated after boot, these keep running as the old copy until a reboot
REBOOT_PKGS = [
    (r"^(systemd|systemd-libs|glibc|dbus|dbus-broker)$", "Core system"),
    (r"^(mesa|vulkan-|nvidia|lib32-nvidia|libdrm$|wayland$|intel-ucode|amd-ucode|linux-firmware)", "Graphics stack / firmware"),
]
KERNEL_FLAVOURS = ("lts", "zen", "hardened", "rt")
REBOOT = "systemctl reboot"

Change = namedtuple("Change", "time action name old new")
# what: the problem; fix: a command that fixes it (None: nothing to run); why: what that command does;
# then: follow-ups needed once the fix worked (each runs once, after all the fixes);
# verify: re-checks afterwards, True when it's fixed (None: can't be re-checked);
# cause: why it broke, in plain words (filled in from what changed since the last good check when not known);
# repairable: False for things that are only news, not breakage (Claude isn't asked about those)
Problem = namedtuple("Problem", "what fix why then verify cause repairable", defaults=(None, None, (), None, None, True))
FIX_LOG = CACHE / "fix.log"  # what the background fixes printed
# Fixes that ask for a password or questions, or take a while: these run in a terminal, never in the background
NEEDS_TERMINAL = re.compile(r"(^|[\s;&|(])(sudo|pkexec|pacdiff|arch-update|makepkg|yay -S|reboot)\b")

# Updating one of these means... (checked in order; each matching package lists once under its advice)
ADVICE = [
    (r"^linux(-lts|-zen|-hardened)?$|^linux-firmware", "Reboot afterwards (new kernel / firmware)."),
    (r"^(nvidia|mesa|vulkan-|intel-ucode|amd-ucode)", "Reboot afterwards (graphics driver / microcode)."),
    (r"^(systemd|glibc|dbus)", "Reboot afterwards (core system library)."),
    (r"^qt6-base$", "Qt changes: arch-update rebuilds Quickshell + Caelestia (~10 min), then run caelestia-patch and log out/in."),
    (r"^hyprland$", "Hyprland changes: arch-update rebuilds the overview plugin; log out and back in afterwards."),
    (r"^(caelestia|quickshell)", "Caelestia changes: run caelestia-patch afterwards so your patched shell copy is refreshed."),
    (r"^(pacman|pambase|filesystem|shadow|sudo|openssh)$", "May leave .pacnew config files in /etc to merge (pacdiff)."),
    (r"^pipewire|^wireplumber", "Audio stack changes: log out/in (or restart pipewire) if sound acts up."),
]


def run(cmd, timeout=180, env=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def online(wait):
    deadline = time.time() + wait
    while True:
        try:
            urllib.request.urlopen("https://archlinux.org", timeout=10)
            return True
        except Exception:
            if time.time() > deadline:
                return False
            time.sleep(10)


def repo_updates():
    """Same trick as checkupdates: sync a private db copy with fakeroot, then ask it."""
    DB.mkdir(parents=True, exist_ok=True)
    local = DB / "local"
    if not local.is_symlink():
        local.symlink_to("/var/lib/pacman/local")
    sync = DB / "sync"
    if not sync.exists():
        shutil.copytree("/var/lib/pacman/sync", sync)
    rc, _, err = run(["fakeroot", "--", "pacman", "-Sy", "--disable-sandbox", "--dbpath", str(DB), "--logfile", "/dev/null"])
    if rc != 0:
        return None, err.strip().splitlines()[-1:] or ["pacman -Sy failed"]
    _, out, _ = run(["pacman", "-Qu", "--dbpath", str(DB)])
    return [l for l in out.splitlines() if l.strip()], None


def aur_updates():
    if not shutil.which("yay"):
        return []
    _, out, _ = run(["yay", "-Qua"])
    return [l for l in out.splitlines() if l.strip()]


def flatpak_updates():
    if not shutil.which("flatpak"):
        return []
    _, installed, _ = run(["flatpak", "list", "--columns=application"])
    if not installed.strip():
        return []
    _, out, _ = run(["flatpak", "remote-ls", "--updates", "--columns=application,version"])
    return [l.replace("\t", " ").strip() for l in out.splitlines() if l.strip()]


def last_full_upgrade():
    last = None
    try:
        with open("/var/log/pacman.log", errors="replace") as f:
            for line in f:
                if "starting full system upgrade" in line:
                    last = line
    except OSError:
        return None
    m = last and re.match(r"\[([^\]]+)\]", last)
    if not m:
        return None
    try:
        return datetime.fromisoformat(m.group(1).replace("Z", "+00:00"))
    except ValueError:
        return None


def news_since(since, installed):
    try:
        data = urllib.request.urlopen(NEWS_URL, timeout=20).read()
    except Exception as e:
        return None, str(e)
    items = []
    for it in ET.fromstring(data).iter("item"):
        date = email.utils.parsedate_to_datetime(it.findtext("pubDate"))
        if since and date <= since:
            continue
        if not since and (datetime.now(timezone.utc) - date).days > 30:
            continue
        title = it.findtext("title", "")
        text = re.sub(r"<[^>]+>", " ", html.unescape(it.findtext("description", "")))
        text = re.sub(r"\s+", " ", text).strip()
        words = set(re.findall(r"[a-z0-9][a-z0-9+._-]+", (title + " " + text).lower()))
        mine = sorted((words & installed) - COMMON_WORDS)
        items.append((date, title, it.findtext("link", ""), text, mine))
    return items, None


def health():
    """arch-update --check, minus what the self-test checks more exactly (Quickshell vs Qt, the Hyprland
    config: its checker crashes with the Lua config)."""
    found = []
    if (BIN / "arch-update").exists():
        _, out, _ = run([str(BIN / "arch-update"), "--check"], timeout=120)
        out = re.sub(r"\x1b\[[0-9;]*m", "", out)
        for l in out.splitlines():
            if "PROBLEM" not in l:
                continue
            what = "arch-update --check: " + l.split("PROBLEM", 1)[1].strip()
            if "Quickshell needs rebuilding" in what or "Hyprland config" in what:
                continue
            if "Overview plugin" in what:
                found.append(Problem(what, "arch-update --build-hymission", "Rebuilds the overview plugin for the "
                                     "installed Hyprland. It's loaded when you log in, so log out and back in afterwards."))
            elif "run: arch-update" in what:
                found.append(Problem(what, "arch-update", "Updates and rebuilds the pieces tied to exact Qt/Hyprland versions."))
            else:
                found.append(Problem(what))
        if "Good news" in out:
            found.append(Problem("Official Caelestia now has the top-bar setting: you can switch with arch-update --official-caelestia.",
                                 repairable=False))
    return found


