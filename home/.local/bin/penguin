                       (*[c / 255 for c in hsv_rgb(random.uniform(0.5, 0.7))], 1.0), 2.4)
            show.things[-1].vy = random.uniform(200, 380)
    key.alive = False
    p.eyes, p.squash = "open", 1.0
    yield from leave(show, side, speed=200)


def act_snap(show):
    """I don't feel so good... (then Tux turns to dust)."""
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    p.face = 1
    p.eyes = "wide"
    yield from say(p, "I don't feel so good...", 1.8)
    surf = p.sprite(False)
    surf.flush()
    data, stride = surf.get_data(), surf.get_stride()
    for sy in range(SPRITE_H):
        for sx in range(SPRITE_W):
            i = sy * stride + sx * 4
            b, g, r, a = data[i], data[i + 1], data[i + 2], data[i + 3]
            if a < 128:
                continue
            x = p.x + p.face * p.s * PX * (sx - SPRITE_W / 2)
            y = show.ground - p.y + p.s * p.squash * (sy - (BY + 22)) * PX
            show.add(Particle("dust", x, y, random.uniform(60, 160), random.uniform(-90, -10),
                              random.uniform(1.0, 1.8), color=(r / 255, g / 255, b / 255), size=PX,
                              delay=(sx / SPRITE_W) * 1.4 + random.uniform(0, 0.25)))
    p.hidden = True
    yield from wait(3.2)
    p.hidden, p.eyes = False, "open"  # ...jk
    p.x = random.uniform(show.w * 0.2, show.w * 0.8)
    p.y = -170
    while p.y < -60:
        p.y += 260 * (yield)
    yield from say(p, "jk", 1.2)
    while p.y > -180:
        p.y -= 320 * (yield)


def act_coffin(show):
    """Four little Tuxes carry a coffin across the screen, in step with the beat."""
    show.p.hidden = True
    going = random.choice((-1, 1))
    x = show.w + 260 if going == -1 else -260
    crew = []
    for i in range(4):
        q = Penguin()
        q.s, q.face, q.wings = 0.55, going, (2.4, 2.4)
        crew.append(q)
        show.add(Buddy(q, show))
    coffin = Sprite(draw_coffin, x, 0)
    show.add(coffin)
    t, beat = 0.0, 0
    while -320 < x < show.w + 320:
        dt = yield
        t += dt
        x += going * 170 * dt
        bob = abs(math.sin(t * 6)) * 10
        for i, q in enumerate(crew):
            q.x = x + (-110 + i * 73)
            q.y = bob
            q.phase = t * 6 + (i % 2) * math.pi
        coffin.x, coffin.y = x, show.ground - bob - 136  # resting on raised flippers
        if int(t * 3) != beat:
            beat = int(t * 3)
            show.add(Particle("text", x + random.uniform(-160, 160), show.ground - 230,
                              random.uniform(-20, 20), -70, 1.6, random.choice("♪♫")))
    for q in show.things:
        if isinstance(q, Buddy):
            q.alive = False
    coffin.alive = False


def act_lava(show):
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    lava = Sprite(draw_lava, 0, 0)
    lava.extra.update(level=0.0, w=show.w, ground=show.ground)
    show.add(lava)
    p.eyes = "wide"
    p.bubble = "THE FLOOR IS LAVA!"
    t = 0.0
    while t < 1.0:
        dt = yield
        t += dt
        lava.extra["level"] = min(70.0, t * 140)
        p.y = min(180.0, t * 400 - 400 * t * t + t * 180)
        p.flap = 0.5 + abs(math.sin(t * 25)) * 1.3
    t = 0.0
    while t < 2.4:  # hover, frantically
        dt = yield
        t += dt
        p.y = 140 + math.sin(t * 5) * 12
        p.flap = 0.5 + abs(math.sin(t * 28)) * 1.4
        if t > 1.2:
            p.bubble = "...how long do I have to do this"
    p.bubble = None
    t = 0.0
    while lava.extra["level"] > 0:
        dt = yield
        t += dt
        lava.extra["level"] = max(0.0, 70 - t * 90)
        p.y = max(0.0, 140 - t * 160)
        p.flap = 0.5
    lava.alive = False
    p.y, p.flap, p.eyes = 0.0, 0.0, "open"
    yield from say(p, "phew", 1.0)
    yield from leave(show, side)


