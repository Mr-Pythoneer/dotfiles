def act_leeroy(show):
    p = show.p
    side = random.choice((-1, 1))
    p.x = 120 if side == -1 else show.w - 120
    p.y = -170
    while p.y < 0:
        p.y = min(0.0, p.y + 400 * (yield))
    p.face = -side
    yield from say(p, "alright chums, let's do this", 2.0)
    p.eyes = "wide"
    t = 0.0
    end = show.w + 200 if side == -1 else -200
    while (end - p.x) * -side > 0:
        dt = yield
        t += dt
        p.x += -side * 700 * dt
        p.phase += dt * 30
        p.y = abs(math.sin(p.phase)) * 10
        p.flap = 1.2 + 0.6 * abs(math.sin(p.phase))
        e = min(10, int(t * 8))
        p.bubble = "LEE" + "E" * e + "ROY" + (" JENKINS!" if t > 1.2 else "")
    p.bubble = None
    p.hidden = True
    yield from wait(1.0)
    show.add(Particle("text", show.w / 2 - 260, show.h * 0.4, 0, -10, 2.2, "at least I have chicken",
                      color=(0.8, 0.8, 0.85, 1.0), size=10, scale=3))
    yield from wait(2.2)


# ---------- the fun CLI tools, in person: fortune, cowsay, pipes.sh, cmatrix ----------

def get_fortune(limit=110):
    """A short real fortune when fortune(6) is installed, else one of Tux's own sayings."""
    import shutil, subprocess
    if shutil.which("fortune"):
        try:
            out = subprocess.run(["fortune", "-s", "-n", str(limit)], capture_output=True, text=True,
                                 timeout=2).stdout
            if out.strip():
                return " ".join(out.split())
        except (OSError, subprocess.SubprocessError):
            pass
    return random.choice(SAYINGS)


def wrap_lines(text, width=34):
    import textwrap
    return textwrap.wrap(text, width) or [text]


def terminal_box(cr, lines, cx, bottom, screen_w, prompt=None, tail=True):
    """Tux's little terminal bubble, for several lines: an optional green prompt line, then the text.
    Centred over cx with its bottom (and stair-stepped tail) at `bottom`."""
    b = 3
    rows = ([("$ " + prompt, True)] if prompt else []) + [(l, False) for l in lines]
    sizes = [pixel_text(cr, t, 0, 0, LIGHT, measure=True) for t, _ in rows]
    w = max(tw for tw, _ in sizes) + 16
    lh = sizes[0][1] - 6
    h = lh * len(rows) + 10
    bx = round(max(10, min(cx - w / 2, screen_w - w - 10)))
    by = round(bottom - h - (18 if tail else 0))
    cr.set_source_rgb(*LIGHT)
    cr.rectangle(bx + b, by, w - 2 * b, h)
    cr.rectangle(bx, by + b, w, h - 2 * b)
    cr.fill()
    cr.set_source_rgb(*PAPER)
    cr.rectangle(bx + b, by + b, w - 2 * b, h - 2 * b)
    cr.fill()
    if tail:
        t = round(min(max(cx, bx + 24), bx + w - 24))
        for i in range(4):
            cr.set_source_rgb(*LIGHT)
            cr.rectangle(t - 12 + i * 3, by + h - b + i * 4, 24 - i * 6, 4)
            cr.fill()
            if i < 3:
                cr.set_source_rgb(*PAPER)
                cr.rectangle(t - 9 + i * 3, by + h - b + i * 4, 18 - i * 6, 4)
                cr.fill()
    for i, (text, is_prompt) in enumerate(rows):
        pixel_text(cr, text, bx + 8, by + 4 + i * lh, (0.31, 0.98, 0.48) if is_prompt else LIGHT)


COW_COL = {"W": (0.95, 0.95, 0.92), "K": (0.13, 0.13, 0.15), "P": (1.0, 0.68, 0.74), "E": INK,
           "H": (0.95, 0.9, 0.75)}
# the cow, as rectangles in sprite pixels: (x, y, w, h, colour), x towards its head, y up from the hooves
COW_BODY = [(-11, -13, 19, 8, "W"), (8, -16, 7, 7, "W")]
COW_SPOTS = [(-9, -12, 4, 3, "K"), (-3, -9, 5, 3, "K"), (4, -13, 3, 2, "K"), (-11, -8, 2, 2, "K"),
             (10, -16, 3, 2, "K"), (6, -15, 2, 1, "K"), (15, -15, 2, 1, "K"), (9, -18, 1, 2, "H"),
             (13, -18, 1, 2, "H"), (8, -11, 7, 2, "P"), (10, -10, 1, 1, "E"), (12, -10, 1, 1, "E"),
             (-1, -5, 3, 1, "P"), (-12, -13, 1, 5, "K"), (-13, -8, 2, 2, "K")]


def draw_cow(cr, c):
    face, step = c.extra["face"], c.extra.get("step", 0.0)
    legs = []
    for i, lx in enumerate((-9, -6, 3, 6)):  # diagonal pairs lift together while walking
        lift = max(0.0, math.sin(step + (0 if i in (0, 3) else math.pi))) * 1.2
        legs.append((lx, -5 - lift, 2, 5, "W"))
        legs.append((lx, -1 - lift, 2, 1, "K"))
    bob = abs(math.sin(step)) * 0.6

    def rect(x, y, w, h, col, grow=0):
        sx = c.x + (x if face > 0 else -(x + w)) * PX
        cr.set_source_rgb(*(INK if grow else COW_COL[col]))
        cr.rectangle(round(sx - grow), round(c.y + (y - bob) * PX - grow), w * PX + 2 * grow, h * PX + 2 * grow)
        cr.fill()

    for shape in COW_BODY + legs:  # a dark outline first, so the cow shows on light wallpapers too
        rect(*shape, grow=3)
    for shape in COW_BODY + legs + COW_SPOTS:
        rect(*shape)
    blink = (c.t % 3.1) < 0.12
    for ex in (9, 12):
        rect(ex, -13, 1, 1 if not blink else 0.4, "E")
    if c.extra.get("lines"):
        terminal_box(cr, c.extra["lines"], c.x + face * 6 * PX, c.y - 19 * PX, c.extra["screen_w"],
                     prompt="fortune | cowsay")


def walk_sprite(sp, tx, speed=240):
    sp.extra["face"] = 1 if tx > sp.x else -1
    while abs(sp.x - tx) > 3:
        dt = yield
        sp.x += sp.extra["face"] * min(speed * dt, abs(sp.x - tx))
        sp.extra["step"] = sp.extra.get("step", 0.0) + dt * 9


def together(*gens):
    """Run several act steps at once (a cow and a penguin walking off together)."""
    gens = list(gens)
    for g in gens:
        next(g)
    while gens:
        dt = yield
        alive = []
        for g in gens:
            try:
                g.send(dt)
                alive.append(g)
            except StopIteration:
                pass
        gens = alive


def act_cowsay(show):
    """fortune | cowsay, in person: a cow walks up to Tux and reads him his fortune."""
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    cow_side = 1 if p.x < show.w / 2 else -1  # the cow comes from the roomier side
    cow = Sprite(draw_cow, show.w + 260 if cow_side == 1 else -260, show.ground)
    cow.extra.update(face=-cow_side, screen_w=show.w)
    show.add(cow)
    p.face = cow_side
    p.eyes = "wide"
    yield from walk_sprite(cow, p.x + cow_side * 260)
    cow.extra["face"] = -cow_side
    p.eyes = "open"
    yield from say(p, random.choice(["moo?", "a cow??", "hi cow", "...cowsay?"]), 1.4)
    text = get_fortune()
    cow.extra["lines"] = wrap_lines(text)
    yield from wait(min(7.0, 2.2 + len(text) / 18))
    cow.extra["lines"] = None
    yield from say(p, random.choice(["wise cow.", "deep.", "moo indeed", "noted", "the cow knows"]), 1.6)
    # the cow heads back where it came from, Tux off the other way
    yield from together(walk_sprite(cow, show.w + 300 if cow_side == 1 else -300),
                        walk_to(p, -160 if cow_side == 1 else show.w + 160, 320))
    cow.alive = False


COOKIE = ["....DDDD....", "..DDYYYYDD..", ".DYYYYYYYYD.", "DYYYYDDYYYYD", "DYYYD..DYYYD", ".DDD....DDD."]
COOKIE_COL = {"Y": (0.93, 0.72, 0.35), "D": (0.66, 0.44, 0.18)}


def draw_cookie_half(cr, c):
    rows = [r[:6] for r in COOKIE] if c.extra["half"] < 0 else [r[6:] for r in COOKIE]
    cr.save()
    cr.translate(c.x, c.y)
    cr.rotate(c.extra.get("spin", 0.0) * c.t)
    blit(cr, rows, COOKIE_COL, -3 * PX if c.extra["half"] < 0 else 0, -3 * PX, PX, c.extra.get("a", 1.0))
    cr.restore()


def draw_cookie(cr, c):
    blit(cr, COOKIE, COOKIE_COL, c.x - 6 * PX, c.y - 3 * PX, PX)


def draw_slip(cr, c):
    """The paper slip, unrolling upwards out of the cookie."""
    k = min(1.0, c.t / 0.6)
    lines = c.extra["lines"]
    sizes = [pixel_text(cr, l, 0, 0, INK, measure=True) for l in lines]
    w = max(tw for tw, _ in sizes) + 20
    lh = sizes[0][1] - 6
    full = lh * len(lines) + 14
    h = max(PX, round(full * k))
    x = round(max(10, min(c.x - w / 2, c.extra["screen_w"] - w - 10)))
    y = round(c.y - h)
    cr.set_source_rgb(0.97, 0.95, 0.88)
    cr.rectangle(x, y, w, h)
    cr.fill()
    cr.set_source_rgb(0.85, 0.82, 0.74)
    cr.rectangle(x, y, w, 3)
    cr.fill()
    if k >= 1:
        for i, l in enumerate(lines):
            pixel_text(cr, l, x + 10, y + 7 + i * lh, (0.75, 0.2, 0.2) if l.startswith("lucky") else INK)


def act_fortune(show):
    """Tux cracks open a fortune cookie and reads the slip."""
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    p.face = 1
    hand = show.ground - 70
    cookie = Sprite(draw_cookie, p.x, -40)
    show.add(cookie)
    p.eyes = "wide"
    yield from move(cookie, p.x, hand, 1.2)
    p.eyes = "open"
    yield from wait(0.4)
    p.flap = 0.8
    cookie.alive = False
    for half in (-1, 1):
        h = Sprite(draw_cookie_half, p.x + half * 10, hand)
        h.extra.update(half=half, spin=half * 3)
        show.add(h)
        show.add(Particle("dust", p.x, hand, half * 120, -60, 0.6, color=COOKIE_COL["Y"], size=PX))
    for _ in range(6):
        show.add(Particle("dust", p.x + random.uniform(-20, 20), hand, random.uniform(-80, 80),
                          random.uniform(-160, -60), 0.7, color=COOKIE_COL["D"], size=PX))
    halves = [t for t in show.things if isinstance(t, Sprite) and t.draw_fn is draw_cookie_half]
    t = 0.0
    while t < 0.5:  # the halves drop away
        dt = yield
        t += dt
        for hs in halves:
            hs.x += (-1 if hs.extra["half"] < 0 else 1) * 160 * dt
            hs.y += 260 * dt * t * 4
            hs.extra["a"] = max(0.0, 1 - t * 2)
    for hs in halves:
        hs.alive = False
    p.flap = 0
    slip = Sprite(draw_slip, p.x, show.ground - 150)
    lucky = " ".join(str(n) for n in sorted(random.sample(range(1, 50), 6)))
    slip.extra.update(lines=wrap_lines(get_fortune(90), 30) + ["", f"lucky numbers: {lucky}"], screen_w=show.w)
    show.add(slip)
    yield from wait(min(7.0, 3.0 + len(" ".join(slip.extra["lines"])) / 20))
    slip.alive = False
    yield from say(p, random.choice(["huh.", "spooky", "accurate", "I'll take it", "...in bed"]), 1.6)
    yield from leave(show, side)


PIPE_COLS = [(0.54, 0.68, 0.96), (0.78, 0.63, 0.96), (0.55, 0.84, 0.79), (0.65, 0.85, 0.58),
             (0.93, 0.83, 0.62), (0.96, 0.66, 0.5), (0.93, 0.53, 0.59)]


def draw_pipes(cr, sp):
    a = sp.extra.get("a", 1.0)
    cell = sp.extra["cell"]
    for col, pts in sp.extra["pipes"]:
        cr.set_source_rgba(*col, a)
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            if abs(x1 - x0) + abs(y1 - y0) > 1:  # wrapped round the screen edge
                continue
            x, y = min(x0, x1) * cell, min(y0, y1) * cell
            w = abs(x1 - x0) * cell + PX * 2
            h = abs(y1 - y0) * cell + PX * 2
            cr.rectangle(round(x - PX), round(y - PX), round(w), round(h))
        cr.fill()


def act_pipes(show):
    """pipes.sh, live: Tux starts the old screensaver and pipes grow all over the screen."""
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    yield from say(p, "pipes.sh", 1.2)
    cell = 4 * PX
    cols, rows = int(show.w / cell), int(show.ground / cell)
    sp = Sprite(draw_pipes, 0, 0)
    sp.extra.update(cell=cell, pipes=[])
    show.add(sp)
    heads = []
    for i in range(6):
        start = (int(p.x / cell), int((show.ground - 100) / cell))
        heads.append([start, random.randrange(4), PIPE_COLS[i % len(PIPE_COLS)]])
        sp.extra["pipes"].append((heads[-1][2], [start]))
    p.eyes = "wide"
    t, steps = 0.0, 0
    while t < 5.0:
        t += yield
        while steps < t * 26:
            steps += 1
            for i, h in enumerate(heads):
                (x, y), d, _ = h
                if random.random() < 0.15:
                    d = (d + random.choice((1, 3))) % 4
                dx, dy = ((0, -1), (1, 0), (0, 1), (-1, 0))[d]
                x, y = (x + dx) % cols, (y + dy) % rows
                h[0], h[1] = (x, y), d
                sp.extra["pipes"][i][1].append((x, y))
    t = 0.0
    while t < 0.8:
        t += yield
        sp.extra["a"] = 1 - t / 0.8
    sp.alive = False
    p.eyes = "open"
    yield from say(p, random.choice(["plumbing!", "it's a series of tubes", "Ctrl+C to exit"]), 1.6)
    yield from leave(show, side)


MATRIX_GLYPHS = "0123456789ABCDEFabcdef$#*+=<>{}[]:;!?%&@"  # cmatrix's own ASCII set: the pixel font has no katakana


def draw_rain(cr, sp):
    a = sp.extra.get("a", 1.0)
    cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(20)
    step = 26
    for col, (speed, offset, length) in enumerate(sp.extra["cols"]):
        head = (sp.t * speed + offset) % (sp.extra["h"] / step + length)
        for k in range(length):
            row = int(head) - k
            if row < 0 or row * step > sp.extra["h"]:
                continue
            g = MATRIX_GLYPHS[(col * 7 + row * 13 + int(sp.t * 6) * (k % 3 == 0)) % len(MATRIX_GLYPHS)]
            if k == 0:
                cr.set_source_rgba(0.85, 1.0, 0.88, a)
            else:
                cr.set_source_rgba(0.2, 0.95, 0.4, a * (1 - k / length) * 0.9)
            cr.move_to(col * step + 4, row * step)
            cr.show_text(g)


def act_cmatrix(show):
    """cmatrix: digital rain pours down the screen while Tux puts his shades on."""
    p = show.p
    side, spot = entry(show)
    yield from walk_to(p, spot)
    rain = Sprite(draw_rain, 0, 0)
    rain.extra.update(h=show.ground, a=0.0,
                      cols=[(random.uniform(8, 20), random.uniform(0, 40), random.randint(6, 16))
                            for _ in range(int(show.w / 26) + 1)])
    show.things.insert(0, rain)  # behind Tux
    t = 0.0
    while t < 0.8:
        t += yield
        rain.extra["a"] = t / 0.8
    p.shades = True
    yield from say(p, "I know kung fu.", 1.8)
    yield from wait(1.2)
    yield from say(p, random.choice(["there is no spoon", "follow the white rabbit", f"I use {DISTRO} btw"]), 1.8)
    t = 0.0
    while t < 0.8:
        t += yield
        rain.extra["a"] = 1 - t / 0.8
    rain.alive = False
    yield from leave(show, side, speed=220)


ACTS = {
    "stroll": act_stroll, "dance": act_dance, "slide": act_slide, "backflip": act_backflip,
    "fish": act_fish, "nap": act_nap, "peek": act_peek, "fly": act_fly,
    "ufo": act_ufo, "chase": act_chase, "snowball": act_snowball, "cool": act_cool,
    "doge": act_doge, "nyan": act_nyan, "dab": act_dab, "floss": act_floss, "loading": act_loading,
    "thisisfine": act_thisisfine, "over9000": act_over9000, "pressf": act_pressf, "snap": act_snap,
    "coffin": act_coffin, "lava": act_lava, "headout": act_headout, "leeroy": act_leeroy,
    "cowsay": act_cowsay, "fortune": act_fortune, "pipes": act_pipes, "cmatrix": act_cmatrix,
}


class Show:
    def __init__(self, act):
        self.p = Penguin()
        self.things = []
        self.w = self.h = 0
        self.ground = 0
        self.act = act
        self.script = None
        self.last = time.monotonic()

    def add(self, thing):
        self.things.append(thing)

    def tick(self):
        now = time.monotonic()
        dt = min(now - self.last, 0.05)
        self.last = now
        if self.w == 0:
            return True
        if self.script is None:
            self.script = self.act(self)
            next(self.script)
        done = False
        try:
            self.script.send(dt)
        except StopIteration:
            done = True
        self.things = [t for t in self.things if t.update(dt)]
        self.area.queue_draw()
        if done and not self.things:
            self.app.quit()
            return False
        return True

    def draw(self, area, cr, w, h):
        self.w, self.h = w, h
        self.ground = h - 14
        self.p.screen_w = w
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_antialias(cairo.ANTIALIAS_NONE)
        for t in self.things:
            t.draw(cr)
        self.p.draw(cr, self.ground)


def main():
    # the fun-CLI acts (cowsay, fortune, pipes.sh, cmatrix) are picked about a third of the time
    fun = ["cowsay", "fortune", "pipes", "cmatrix"]
    pick = random.choice(fun) if random.random() < 0.33 else random.choice(list(ACTS))
    name = sys.argv[1] if len(sys.argv) > 1 else pick
    if name not in ACTS:
        sys.exit("acts: " + ", ".join(ACTS))

    # one penguin at a time: a new press sends the old one home
    try:
        os.kill(int(open(PIDFILE).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    show = Show(ACTS[name])
    app = Gtk.Application(application_id=None)
    show.app = app

    def activate(app):
        win = Gtk.ApplicationWindow(application=app)
        Layer.init_for_window(win)
        Layer.set_namespace(win, "penguin")
        Layer.set_layer(win, Layer.Layer.OVERLAY)
        for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
            Layer.set_anchor(win, edge, True)
        Layer.set_exclusive_zone(win, -1)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)

        css = Gtk.CssProvider()
        css.load_from_string("window { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        area = Gtk.DrawingArea()
        area.set_draw_func(show.draw)
        show.area = area
        win.set_child(area)
        # clicks go straight through to whatever is underneath
        win.connect("realize", lambda w: w.get_surface().set_input_region(cairo.Region()))
        win.present()
        GLib.timeout_add(16, show.tick)
        GLib.timeout_add_seconds(30, app.quit)  # safety net

    app.connect("activate", activate)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, app.quit)
    try:
        app.run([])
    finally:
        try:
            if open(PIDFILE).read() == str(os.getpid()):
                os.remove(PIDFILE)
        except OSError:
            pass


if __name__ == "__main__":
    main()
