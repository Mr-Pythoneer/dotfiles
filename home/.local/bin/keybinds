#!/usr/bin/env python3
"""Keybinds: make your own keyboard shortcuts for Hyprland.

A shortcut runs one or more steps, top to bottom: open an app (or switch to it), run a command, open a
website/file/folder, type text, press keys, a window or workspace action, a desktop action, or wait.
They're kept in ~/.config/hypr/keybinds.json and written out as ~/.config/hypr/keybinds.lua, which
hyprland.lua loads last, so a shortcut can also replace a built-in one (hl.unbind). Hyprland reloads on
save. Shortcuts with several steps, or that open apps, type or press keys, run through
~/.local/bin/keybind-run; single commands and window actions are bound directly.

Recording keys: while you press a shortcut, Hyprland is switched to the empty submap "keybinds-capture"
(defined in keybinds.lua), so keys that already do something reach this window instead. Escape, 15
seconds, or leaving the window switches back.

Testing: KEYBINDS_DIR=<dir> writes the json/lua there and skips the reload; KEYBINDS_SHOT=<png> renders
the window (KEYBINDS_SHOT_EDIT=<index|new>, KEYBINDS_SHOT_STEP=<kind>) and quits.
"""
import copy
import json
import os
import re
import shlex
import subprocess
import tempfile
import uuid

