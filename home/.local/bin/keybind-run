#!/usr/bin/env python3
"""Runs the steps of a shortcut made in the Keybinds app (~/.local/bin/keybinds).

    keybind-run <id>                  run a saved shortcut from ~/.config/hypr/keybinds.json
    keybind-run --steps '<json>'      run a list of steps directly
    --window address:0x…              send typed text / keys to that window instead of the focused one

Hyprland calls this for shortcuts with more than one step, or ones that open apps, type or press keys.
Keys and text go through Hyprland's send_shortcut, straight to the window, so the Super you're still
holding down doesn't turn typed letters into other shortcuts.
"""
import json
import os
import shutil
import subprocess
import sys
import time

DATA = os.path.expanduser("~/.config/hypr/keybinds.json")

# US layout: character -> (modifiers, key) for send_shortcut, which only finds keys by their unshifted symbol
PLAIN = {" ": "space", "\n": "Return", "\t": "Tab", "-": "minus", "=": "equal", "[": "bracketleft",
         "]": "bracketright", "\\": "backslash", ";": "semicolon", "'": "apostrophe", "`": "grave",
         ",": "comma", ".": "period", "/": "slash"}
SHIFTED = {"!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7", "*": "8", "(": "9",
           ")": "0", "_": "minus", "+": "equal", "{": "bracketleft", "}": "bracketright", "|": "backslash",
           ":": "semicolon", '"': "apostrophe", "<": "comma", ">": "period", "?": "slash", "~": "grave"}
TERMINALS = {"kitty", "foot", "alacritty", "org.wezfurlong.wezterm", "com.mitchellh.ghostty", "ghostty",
             "org.gnome.console", "org.gnome.terminal", "konsole", "xterm", "wezterm"}


def lua_str(s):
    out = []
    for ch in s:
        if ch in '\\"':
            out.append("\\" + ch)
        elif ch == "\n":
            out.append("\\n")
        elif ord(ch) < 32:
            out.append("\\%03d" % ord(ch))
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def hypr(*args, check=False):
    r = subprocess.run(["hyprctl", *args], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    if check and (r.returncode or out.lower().startswith("error") or "error:" in out.lower()):
        raise RuntimeError(out or "hyprctl failed")
    return out


def hypr_json(what):
    try:
        return json.loads(hypr(what, "-j"))
    except (json.JSONDecodeError, OSError):
        return {} if what == "activewindow" else []


def notify(title, body):
    subprocess.Popen(["notify-send", "-a", "Keybinds", "-i", "preferences-desktop-keyboard-shortcuts",
                      title, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def spawn(cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def send_keys(keys, window):
    """keys: [(mods, key)]; all in one Lua chunk so they arrive in order and fast."""
    if not keys:
        return
    target = f", window = {lua_str(window)}" if window else ""
    table = ", ".join("{%s, %s}" % (lua_str(m), lua_str(k)) for m, k in keys)
    hypr("eval", f"for _, k in ipairs({{{table}}}) do hl.dispatch(hl.dsp.send_shortcut({{ mods = k[1], key = k[2]{target} }})) end",
         check=True)


def type_text(text, window):
    keys = []
    for ch in text:
        if ch.isascii() and ch.isalnum():
            keys.append(("SHIFT", ch.lower()) if ch.isupper() else ("", ch))
        elif ch in PLAIN:
            keys.append(("", PLAIN[ch]))
        elif ch in SHIFTED:
            keys.append(("SHIFT", SHIFTED[ch]))
        else:
            return paste_text(text, window)   # emoji, accents…: no key for them, so paste instead
    send_keys(keys, window)


def paste_text(text, window):
    old = None
    try:
        types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=2).stdout
        if "text/plain" in types:
            old = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        pass
    subprocess.run(["wl-copy", "--", text])
    cls = (hypr_json("activewindow").get("class") or "").lower()
    send_keys([("CTRL SHIFT" if cls in TERMINALS else "CTRL", "v")], window)
    time.sleep(0.4)
    if old is not None:
        subprocess.run(["wl-copy"], input=old)


def app_matches(cls, step):
    c = (cls or "").lower()
    if not c:
        return False
    names = {n.lower() for n in step.get("classes", []) if n}
    return c in names or any(c.endswith("." + n) or n.endswith("." + c) for n in names)


def open_app(step, more_after):
    wins = [w for w in hypr_json("clients") if w.get("mapped") and app_matches(w.get("class"), step)]
    if step.get("focus", True) and wins:
        active = hypr_json("activewindow").get("address")
        addrs = [w["address"] for w in sorted(wins, key=lambda w: w.get("focusHistoryID", 0))]
        # already in front: go to its next window, if it has more than one
        nxt = addrs[(addrs.index(active) + 1) % len(addrs)] if active in addrs else addrs[0]
        if nxt != active:
            hypr("dispatch", f"hl.dsp.focus({{ window = {lua_str('address:' + nxt)} }})")
        return
    app_id = step["app"].removesuffix(".desktop")
    spawn(["gtk-launch", app_id] if shutil.which("gtk-launch") else ["gio", "launch", step.get("path", "")])
    if more_after:   # the next steps probably want its window: wait for it to come up and take focus
        end = time.time() + 10
        while time.time() < end:
            if app_matches(hypr_json("activewindow").get("class"), step):
                time.sleep(0.3)
                return
            time.sleep(0.1)


def run(steps, window=None):
    for i, step in enumerate(steps):
        kind = step.get("type")
        if kind == "app":
            open_app(step, i < len(steps) - 1)
        elif kind == "command":
            cmd = step.get("command", "")
            spawn(["kitty", "--hold", "sh", "-c", cmd] if step.get("terminal") else ["sh", "-c", cmd])
        elif kind == "link":
            spawn(["xdg-open", os.path.expanduser(step.get("target", ""))])
        elif kind == "text":
            type_text(step.get("text", ""), window)
        elif kind == "keys":
            k = step.get("keys", {})
            key = k.get("key", "")
            key = key.lower() if len(key) == 1 else key   # shown as "T", sent as the plain t key
            send_keys([(" ".join(k.get("mods", [])), key)] * max(1, int(step.get("times", 1))), window)
        elif kind in ("hypr", "system"):
            if step.get("lua"):
                hypr("dispatch", step["lua"], check=True)
            elif step.get("command"):
                spawn(["sh", "-c", step["command"]])
        elif kind == "wait":
            time.sleep(max(0.0, float(step.get("seconds", 1))))


def main(argv):
    window = None
    if "--window" in argv:
        i = argv.index("--window")
        window = argv[i + 1]
        del argv[i:i + 2]
    if len(argv) >= 2 and argv[0] == "--steps":
        steps, name = json.loads(argv[1]), "Test"
    elif len(argv) == 1:
        try:
            with open(DATA) as f:
                bind = next(b for b in json.load(f).get("binds", []) if b.get("id") == argv[0])
        except (OSError, ValueError, StopIteration):
            notify("Shortcut not found", f"No saved shortcut with id {argv[0]}. Open Keybinds to check it.")
            return 1
        steps, name = bind.get("steps", []), bind.get("name") or "Shortcut"
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        run(steps, window)
    except Exception as e:  # noqa: BLE001 — anything going wrong should show up as a notification
        notify(f"{name} didn't finish", str(e)[:300])
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
