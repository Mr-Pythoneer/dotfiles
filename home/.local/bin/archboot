#!/usr/bin/env python3
"""archboot — terminal eye candy: a random animated scene with your system info, played once.

Usage: archboot                 boot lines, then a random scene, played once
       archboot --no-boot       skip the boot lines (alias: archfetch)
       archboot --scene NAME    a specific scene (archboot --list shows them; alias: scene NAME)
       archboot --screensaver   every scene in turn, full-screen with a clock; any key quits
Any key skips to the end; Esc stops it and clears the screen.
"""
import colorsys, math, os, pwd, random, select, shutil, signal, socket, sys, termios, time, tty

ESC = "\x1b["
RESET = ESC + "0m"


def distro_id():
    if os.environ.get("ARCHBOOT_BRAND"):  # preview another distro's look: ARCHBOOT_BRAND=fedora archboot
        return os.environ["ARCHBOOT_BRAND"]
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("ID="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "arch"


# Everything that names the distro comes from here, so the same file is Arch on the desktop and Fedora in the VM
BRANDS = {
    "arch": {"name": "Arch Linux", "word": "Arch", "caps": "ARCH", "blue": (23, 147, 209), "pm": "pacman",
             "upgrade": "sudo pacman -Syu", "sync": [":: Synchronizing", " core   up to date", " extra  up to date"],
             "ticker": "$ARCH", "vision": "ARCHVISION", "since": "2002", "fan": "pacman_-Syu"},
    "fedora": {"name": "Fedora Linux", "word": "Fedora", "caps": "FEDORA", "blue": (81, 162, 218), "pm": "dnf",
               "upgrade": "sudo dnf upgrade", "sync": ["Updating and loading", " repositories...", "Nothing to do."],
               "ticker": "$RHT", "vision": "RED HAT VISION", "since": "1993", "fan": "dnf_upgrade"},
}
BRAND = BRANDS.get(distro_id(), BRANDS["arch"])
FEDORA = BRAND is BRANDS["fedora"]
BRAND_BLUE = BRAND["blue"]

# ── Tux sprite (20×22 pixels, drawn with half-blocks so pixels come out square) ──
BODY = [
    ".......KKKKKK.......",
    "......KKGGGGKK......",
    ".....KKGGKKKKKK.....",
    ".....KWWKKKKWWK.....",
    ".....KWEKKKKEWK.....",
    ".....KKYYYYYYKK.....",
    ".....KYYYYYYYYK.....",
    "....KKKYYYYYYKKK....",
    "....KKWWWYYWWWKK....",
    "...KKWWWWWWWWWWKK...",
    "...KWWWWWWWWWWWWK...",
    "..KKWWWWWWWWWWWWKK..",
    "..KWWWWWWWWWWWWWWK..",
    "..KWWWWWWWWWWWWWWK..",
    "..KWWWWWWWWWWWWWWK..",
    "..KWWWWWWWWWWWWWWK..",
    "..KKWWWWWWWWWWWWKK..",
    "...KWWWWWWWWWWWWK...",
    "...KKWWWWWWWWWWKK...",
    "....KKKKKKKKKKKK....",
]
FOOT_L = ["..YYYYY...", ".DYYYYY..."]
FOOT_R = ["...YYYYY..", "...YYYYYD."]
PAL = {
    "K": (62, 65, 77), "G": (105, 110, 126), "W": (236, 236, 228),
    "E": (16, 16, 20), "Y": (255, 178, 36), "D": (214, 122, 22),
}


def tux(pix, ox, oy, t, move="dance", walk_dir=1):
    """Draw Tux into pix {(x, y): rgb} with its top-left at (ox, oy)."""
    beat = t * 2.0  # 120 bpm
    if isinstance(move, tuple):  # an explicit pose: ("pose", left flipper, right flipper, (lift_l, lift_r))
        al, ar, lift = move[1], move[2], move[3]
    elif move == "swim":  # slow breaststrokes and kicking feet
        al = ar = 1.1 + 0.8 * math.sin(t * 3)
        lift = (1, 0) if int(t * 3) % 2 else (0, 1)
    elif move == "dance":
        style = int(beat / 4) % 3
        if style == 0:    # alternating flaps
            al = 0.5 + 1.6 * (0.5 + 0.5 * math.sin(math.pi * beat))
            ar = 0.5 + 1.6 * (0.5 - 0.5 * math.sin(math.pi * beat))
        elif style == 1:  # hands in the air
            al = ar = 2.3 + 0.5 * math.sin(math.pi * beat * 2)
        else:             # chicken dance
            al = ar = 0.9 + 0.7 * abs(math.sin(math.pi * beat * 2))
        ox += round(3 * math.sin(math.pi * beat / 2))
        oy -= int(abs(math.sin(math.pi * beat)) * 2.2)
        lift = (0, 1) if int(beat) % 2 else (1, 0)
    elif move == "walk":
        al = ar = 0.5 + 0.35 * abs(math.sin(t * 8))
        oy -= int(abs(math.sin(t * 8)) * 1.5)
        lift = (1, 0) if int(t * 5) % 2 else (0, 1)
    elif move == "type":  # flippers pattering on a keyboard
        al = 0.8 + 0.18 * math.sin(t * 23)
        ar = 0.8 + 0.18 * math.sin(t * 23 + 1.7)
        lift = (0, 0)
    elif move == "fish":  # left flipper relaxed, right one holding the rod out
        al, ar = 0.45 + 0.05 * math.sin(t * 2), 1.35
        lift = (0, 0)
    elif move == "idle":
        al = ar = 0.45 + 0.05 * math.sin(t * 2)
        lift = (0, 0)
    else:                 # "wave": standing, right flipper waving hello
        al = 0.45
        ar = 2.4 + 0.45 * math.sin(t * 10)
        lift = (0, 0)

    def put(x, y, c):
        pix[(ox + x, oy + y)] = c

    for side, ang, sx in ((-1, al, 3.5), (1, ar, 16.5)):  # flippers behind the body
        dx, dy = side * math.sin(ang), math.cos(ang)
        for i in range(15):
            s = i * 0.5
            w = 3 if s < 3 else 2 if s < 6 else 1  # thick at the shoulder, tapering to the tip
            for k in range(w):
                put(round(sx + dx * s - side * dy * k), round(10 + dy * s + side * dx * k), PAL["K"])

    blink = (t % 3.1) < 0.13
    for y, line in enumerate(BODY):
        for x, ch in enumerate(line):
            if ch == ".":
                continue
            if blink and y in (3, 4) and ch in "WE":
                ch = "K" if y == 3 else "W"
            put(x, y, PAL[ch])
    for foot, x0, up in ((FOOT_L, 0, lift[0]), (FOOT_R, 10, lift[1])):
        for y, line in enumerate(foot):
            for x, ch in enumerate(line):
                if ch != ".":
                    put(x0 + x, 20 + y - up, PAL[ch])


# ── drawing helpers ──
def hsv(h, s=0.7, v=1.0):
    return tuple(int(c * 255) for c in colorsys.hsv_to_rgb(h % 1.0, s, v))


def scale(c, f):
    return tuple(int(v * f) for v in c)


class Painter:
    """Builds a row of cells, only emitting colour codes when they change.
    Painter.fade (0..1) dims every colour toward Painter.base, for fading scenes in and out."""
    fade, base = 1.0, (6, 7, 9)

    def __init__(self):
        self.parts, self.fg, self.bg = [], None, None

    @classmethod
    def faded(cls, c):
        if cls.fade >= 1:
            return c
        return tuple(round(b + (x - b) * cls.fade) for x, b in zip(c, cls.base))

    def cell(self, ch, fg=None, bg=None):
        if fg != self.fg:
            fc = self.faded(fg) if fg else None
            self.parts.append(f"{ESC}38;2;{fc[0]};{fc[1]};{fc[2]}m" if fg else ESC + "39m")
            self.fg = fg
        if bg != self.bg:
            bc = self.faded(bg) if bg else None
            self.parts.append(f"{ESC}48;2;{bc[0]};{bc[1]};{bc[2]}m" if bg else ESC + "49m")
            self.bg = bg
        self.parts.append(ch)

    def text(self, s, fg=None, bold=False):
        if bold:
            self.parts.append(ESC + "1m")
        for ch in s:
            self.cell(ch, fg, None)
        if bold:
            self.parts.append(ESC + "22m")

    def done(self):
        self.parts.append(RESET + ESC + "K")
        self.fg = self.bg = None
        s = "".join(self.parts)
        self.parts = []
        return s


def compose(p, pix, text, row, width, bg=None):
    """Draw one terminal row: text with its own background wins, then pixels, then plain text."""
    for col in range(width):
        cell = text.get((col, row))
        if cell and len(cell) == 3:
            p.cell(*cell)
            continue
        top, bot = pix.get((col, row * 2)), pix.get((col, row * 2 + 1))
        if top and bot:
            p.cell("▀", top, bot) if top != bot else p.cell("█", top, bg)
        elif top:
            p.cell("▀", top, bg)
        elif bot:
            p.cell("▄", bot, bg)
        elif (col, row) in text:
            ch, fg = text[(col, row)]
            p.cell(ch, fg, bg)
        else:
            p.cell(" ", None, bg)


# ── input / terminal ──
class KeyWatch:
    """cbreak mode so a keypress can skip; restores the tty afterwards.
    Esc sets .escaped too, meaning "get out of the way now", not just "skip ahead"."""

    def __enter__(self):
        self.fd = sys.stdin.fileno() if sys.stdin.isatty() else None
        if self.fd is not None:
            self.old = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        self.hit = self.escaped = False
        self.key = b""
        return self

    def wait(self, secs):
        if self.hit:
            return True
        if self.fd is None:
            time.sleep(secs)
        elif select.select([self.fd], [], [], secs)[0]:
            self.hit = True
            self.key = os.read(self.fd, 64)
            self.escaped = self.key.startswith(b"\x1b")
        return self.hit

    def __exit__(self, *exc):
        if self.fd is not None:
            termios.tcflush(self.fd, termios.TCIFLUSH)  # don't leak the key into the prompt
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)


def out(s):
    sys.stdout.write(s)
    sys.stdout.flush()


# ── system info ──
def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def sysinfo():
    user = pwd.getpwuid(os.getuid()).pw_name
    osname = BRAND["name"]
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            osname = line.split("=", 1)[1].strip('"')
    up = int(float(read("/proc/uptime", "0").split()[0]))
    h, m = divmod(up // 60, 60)
    pkgs, pm = "?", BRAND["pm"]
    try:
        pkgs = str(len(os.listdir("/var/lib/pacman/local")) - 1)
    except OSError:
        if shutil.which("rpm"):
            import subprocess
            r = subprocess.run(["rpm", "-qa", "--qf", ".\\n"], capture_output=True, text=True)
            pkgs, pm = str(r.stdout.count(".")), "rpm"
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0])
    cpu = "?"
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            cpu = " ".join(line.split(":", 1)[1].split())
            cpu = cpu.replace("(R)", "").replace("(TM)", "").split(" @")[0]
            break
    title = f"{user}@{socket.gethostname()}"
    return [
        ("", title), ("", "─" * len(title)),
        ("OS", osname), ("Kernel", os.uname().release),
        ("Uptime", f"{h}h {m}m" if h else f"{m}m"),
        ("Packages", f"{pkgs} ({pm})"),
        ("Shell", os.path.basename(os.environ.get("SHELL", "bash"))),
        ("WM", os.environ.get("XDG_CURRENT_DESKTOP", "?")),
        ("CPU", cpu[:30]),
        ("Memory", f"{(mem.get('MemTotal', 0) - mem.get('MemAvailable', 0)) // 1024} / "
                   f"{mem.get('MemTotal', 0) // 1024} MiB"),
    ]


HOLD = 0.4  # a beat on the last frame of a story before the splash stops animating


# ── splash scenes: each paints a 40×30-pixel stage (15 text rows) beside the system info ──
STAGE_W, STAGE_ROWS = 40, 15
NOTES = "♪♫♬♩"


def disc(pix, cx, cy, r, color):
    for y in range(int(cy - r) - 1, int(cy + r) + 2):
        for x in range(int(cx - r) - 1, int(cx + r) + 2):
            if math.hypot(x + 0.5 - cx, y + 0.5 - cy) <= r:
                pix[(x, y)] = color


def put_text(text, col, row, s, color):
    for i, ch in enumerate(s):
        if ch != " ":
            text[(col + i, row)] = (ch, color)


class Dance:
    """Tux dancing on a disco floor, music notes floating up."""

    def __init__(self):
        self.notes, self.last_beat = [], -1  # note: [x, y, vx, char, hue, born]

    def frame(self, t, done):
        pix, text = {}, {}
        beat = int(t * 2)
        if not done and beat != self.last_beat:
            self.last_beat = beat
            for _ in range(2):
                self.notes.append([random.choice((8, 9, 30, 31)), 7.0, random.uniform(-0.5, 0.5),
                                   random.choice(NOTES), random.random(), t])
        for n in self.notes:
            n[0] += n[2] * 0.15
            n[1] -= 0.12
        self.notes = [n for n in self.notes if n[1] > 0 and t - n[5] < 2.2]
        for x, y, _, ch, hue, born in self.notes:
            text[(int(x), int(y))] = (ch, hsv(hue + t * 0.3, 0.6, max(0.25, 1 - (t - born) / 2.2)))
        for i in range(10):  # twinkling sparkles
            r = random.Random(i * 7919)
            sx, sy = r.randrange(STAGE_W), r.randrange(STAGE_ROWS - 6)
            if math.sin(t * 3 + i * 1.7) > 0.6:
                text.setdefault((sx, sy), ("✦" if i % 3 == 0 else "·", hsv(0.55 + i * 0.03, 0.4)))
        tux(pix, 10, 3, t, "wave" if done else "dance")
        for y in range(26, 30):  # disco floor
            for x in range(STAGE_W):
                lit = 0.55 if (x // 4 + (y - 26) // 2 + beat) % 2 else 0.16
                c = scale(BRAND_BLUE, lit * 0.6) if done else hsv(0.55 + 0.12 * math.sin(x * 0.3 + t * 2), 0.65, lit)
                pix[(x, y)] = scale(c, 0.6) if y % 2 else c
        return pix, text


class Pacman:
    """pacman -Syu, literally: Pac-Man eats the updates, grabs the power pellet, the ghost flees."""
    TRAVEL = 3.0

    def over(self, t):  # ghost has fled off-screen, then a moment to enjoy it
        return t > self.TRAVEL + 2.5 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        put_text(text, 1, 0, ("$ " + BRAND["upgrade"])[:max(0, int(t * 30))], (200, 200, 205))
        for y, f in ((4, 1.0), (6, 0.45), (22, 0.45), (24, 1.0)):  # maze walls
            for x in range(STAGE_W):
                pix[(x, y)] = scale(BRAND_BLUE, f)
        p = 1.0 if done else min(1.0, t / self.TRAVEL)
        cx, cy = -7 + p * 39, 14.0
        scared = done or t >= self.TRAVEL
        for x in range(2, 31, 4):  # pellets still ahead of Pac-Man
            if x > cx:
                for dx in (0, 1):
                    for dy in (0, 1):
                        pix[(x + dx, 13 + dy)] = (255, 184, 151)
        if not scared and int(t * 6) % 2:
            disc(pix, 35, 14, 2.2, (255, 184, 151))  # power pellet
        mouth = 0.8 * abs(math.sin(t * 14))
        for y in range(7, 22):
            for x in range(int(cx) - 8, int(cx) + 9):
                dx, dy = x + 0.5 - cx, y + 0.5 - cy
                if math.hypot(dx, dy) <= 6.5 and abs(math.atan2(dy, dx)) >= mouth:
                    pix[(x, y)] = (255, 214, 0)
        # the ghost chases, until the power pellet turns it blue and it runs
        if scared:
            gx = 10 if done else cx - 17 - (t - self.TRAVEL) * 12
            flash = not done and int(t * 8) % 2 and t - self.TRAVEL > 0.6
            body = (240, 240, 250) if flash else (40, 50, 220)
        else:
            gx, body = cx - 17, (238, 62, 62)
        self.ghost(pix, int(gx), 8, t, body, scared)
        width = 26  # ILoveCandy progress bar
        pos = int(p * width)
        bar = "-" * pos + ("C" if int(t * 8) % 2 else "c") + "".join(" o"[i % 2] for i in range(width - pos - 1))
        put_text(text, 1, 13, ":: there is nothing to do" if scared else ":: Starting full system upgrade...",
                 (150, 160, 175))
        put_text(text, 1, 14, "[", (110, 110, 120))
        for i, ch in enumerate(bar[:width]):
            text[(2 + i, 14)] = (ch, (255, 214, 0) if ch in "Cc" else (255, 184, 151) if ch == "o" else (90, 90, 100))
        put_text(text, 2 + width, 14, f"] {int(p * 100):3d}%", (110, 110, 120))
        return pix, text

    @staticmethod
    def ghost(pix, gx, gy, t, body, scared):
        for y in range(14):
            for x in range(14):
                dx, dy = x + 0.5 - 7, y + 0.5 - 7
                if (y < 7 and math.hypot(dx, dy) <= 7) or 7 <= y < 12 or (y >= 12 and (x + int(t * 8)) % 4 < 2):
                    pix[(gx + x, gy + y)] = body
        if scared:
            for ex in (4, 9):
                pix[(gx + ex, gy + 5)] = (255, 184, 151)
            for x in range(2, 12):
                pix[(gx + x, gy + 9 + x % 2)] = (255, 184, 151)
        else:
            for ex in (2, 8):
                for x in range(3):
                    for y in range(4):
                        pix[(gx + ex + x, gy + 3 + y)] = (240, 240, 250)
                for x in range(2):
                    for y in range(2):
                        pix[(gx + ex + 1 + x, gy + 5 + y)] = (40, 50, 200)


class Snow:
    """Tux in an Arch-blue scarf, snow falling and piling up under the moon."""


    def __init__(self):
        r = random.Random()
        self.flakes = [(r.uniform(0, 40), r.uniform(0, 32), r.uniform(3, 7), r.uniform(0, 6.3)) for _ in range(45)]

    def frame(self, t, done):
        pix, text = {}, {}
        disc(pix, 35.5, 4.5, 3.4, (238, 232, 200))  # moon
        pix[(34, 3)] = pix[(36, 6)] = (205, 198, 165)
        for y in range(10, 26):  # pine tree, three tiers, snow on the edges
            k = y - 10
            half = (k % 5) * 0.9 + (k // 5) * 1.2 + 0.6
            for x in range(STAGE_W):
                d = abs(x + 0.5 - 34)
                if d <= half:
                    pix[(x, y)] = (225, 232, 245) if d > half - 1 and k % 5 == 4 else (34, 84, 62)
        pix[(33, 26)] = pix[(34, 26)] = (100, 70, 45)
        tux(pix, 8, 4, t, "wave" if done else "idle")
        for x in range(3 + 8, 17 + 8):  # scarf around the neck, tail flapping in the wind
            pix[(x, 13)] = BRAND_BLUE
            pix[(x, 14)] = scale(BRAND_BLUE, 0.7)
        for i, y in enumerate(range(15, 20)):
            pix[(21 + round(math.sin(t * 5 + i * 0.8) * (i * 0.35)), y)] = BRAND_BLUE if i % 2 else scale(BRAND_BLUE, 0.7)
        pile = min(1.5, t * 0.45) if not done else 1.5
        for x in range(STAGE_W):  # snowdrift, growing as the snow falls
            top = int(26.5 - pile - 1.2 * math.sin(x * 0.3) - 0.8 * math.sin(x * 0.11 + 1))
            for y in range(top, 30):
                pix[(x, y)] = (240, 245, 255) if y == top else (200, 212, 232)
        for x0, y0, speed, ph in self.flakes:
            y = (y0 + speed * t) % 32 - 2
            x = x0 + math.sin(t * 1.5 + ph) * 1.5
            pix.setdefault((int(x), int(y)), (235, 240, 255) if speed > 5 else (150, 160, 185))  # behind Tux
        return pix, text


class FedoraLogo:
    """The Fedora logo assembling itself from a swirl of particles, then shimmering."""

    def __init__(self):
        r = random.Random()
        self.parts = []
        cx, cy, rad = 20.0, 12.5, 12.0
        for y in range(26):
            for x in range(STAGE_W):
                u, v = x + 0.5 - cx, y + 0.5 - cy
                if math.hypot(u, v * 1.0) > rad:
                    continue
                # the white f: a stem, its hook over the top to the right, and the crossbar
                stem = -4.5 <= u <= -1.0 and -5.0 <= v <= 8.0
                hook = math.hypot(u - 0.75, v + 5.0) <= 5.25 and math.hypot(u - 0.75, v + 5.0) >= 1.75 and v <= -5.0 and u >= -4.5
                bar = -9.0 <= u <= 3.0 and -0.5 <= v <= 2.5
                tail = 1.75 <= math.hypot(u + 5.25, v - 5.5) <= 5.0 and v >= 5.5 and u <= -1.0  # curls back left
                white = stem or hook or bar or tail
                a, rr = r.uniform(0, 2 * math.pi), r.uniform(22, 34)
                self.parts.append((x, y, cx + math.cos(a) * rr, 13 + math.sin(a) * rr * 0.6,
                                   r.uniform(0, 0.6) + y * 0.015, r.random(), white))

    def frame(self, t, done):
        pix, text = {}, {}
        for x, y, sx, sy, delay, hue, white in self.parts:
            p = 1.0 if done else max(0.0, min(1.0, (t - delay) / 1.3))
            e = 1 - (1 - p) ** 3
            spin = (1 - e) * 1.8
            ox, oy = sx - x, sy - y
            px = x + (ox * math.cos(spin) - oy * math.sin(spin)) * (1 - e)
            py = y + (ox * math.sin(spin) + oy * math.cos(spin)) * (1 - e)
            v = 0.8 + 0.2 * max(0.0, math.sin(x * 0.25 + y * 0.5 - t * 6)) ** 8
            final = scale((240, 242, 246), v) if white else scale((60, 110, 180), v + 0.1 * math.sin(y * 0.35 - t * 4))
            spark = hsv(hue, 0.5, 1.0)
            pix[(round(px), round(py))] = tuple(min(255, int(a + (b - a) * e)) for a, b in zip(spark, final))
        title = "F E D O R A   L I N U X"
        shown = title if done else title[:max(0, int((t - 1.9) * 14))]
        for i, ch in enumerate(shown):
            if ch != " ":
                text[(8 + i, 14)] = (ch, scale(BRAND_BLUE, 0.85 + 0.15 * math.sin(t * 3 + i * 0.4)))
        return pix, text


class ArchLogo:
    """The Arch logo assembling itself from a swirl of particles, then shimmering."""


    def __init__(self):
        r = random.Random()
        self.parts = []
        for y in range(26):
            for x in range(STAGE_W):
                u, yy = x + 0.5 - 20, y + 0.5
                if abs(u) >= (y + 1) * 0.6:
                    continue
                if (u / 6.5) ** 2 + ((yy - 27) / 11.5) ** 2 < 1:  # the arch under the peak
                    continue
                ax, ay, bx, by = -10.0, 18.5, 2.0, 11.0  # the slanted notch on the left
                s = max(0, min(1, ((u - ax) * (bx - ax) + (yy - ay) * (by - ay)) / ((bx - ax) ** 2 + (by - ay) ** 2)))
                if math.hypot(u - (ax + s * (bx - ax)), yy - (ay + s * (by - ay))) < 0.9 and s < 0.98:
                    continue
                a, rad = r.uniform(0, 2 * math.pi), r.uniform(22, 34)
                self.parts.append((x, y, 20 + math.cos(a) * rad, 13 + math.sin(a) * rad * 0.6,
                                   r.uniform(0, 0.6) + y * 0.015, r.random()))

    def frame(self, t, done):
        pix, text = {}, {}
        for x, y, sx, sy, delay, hue in self.parts:
            p = 1.0 if done else max(0.0, min(1.0, (t - delay) / 1.3))
            e = 1 - (1 - p) ** 3
            spin = (1 - e) * 1.8  # swirl in rather than flying straight
            ox, oy = sx - x, sy - y
            px = x + (ox * math.cos(spin) - oy * math.sin(spin)) * (1 - e)
            py = y + (ox * math.sin(spin) + oy * math.cos(spin)) * (1 - e)
            wave = math.sin(y * 0.35 + x * 0.18 - t * 4)
            v = 0.75 + 0.25 * max(0.0, math.sin(x * 0.25 + y * 0.5 - t * 6)) ** 8
            final = hsv(0.55 + 0.05 * wave, 0.8, v)
            spark = hsv(hue, 0.5, 1.0)
            pix[(round(px), round(py))] = tuple(int(a + (b - a) * e) for a, b in zip(spark, final))
        title = "A R C H   L I N U X"
        shown = title if done else title[:max(0, int((t - 1.9) * 14))]
        for i, ch in enumerate(shown):
            if ch != " ":
                text[(10 + i, 14)] = (ch, hsv(0.55 + 0.04 * math.sin(t * 3 + i * 0.4), 0.6))
        return pix, text


class Hacker:
    """Tux at the keyboard while a terminal scrolls through a kernel build and an upgrade."""
    STAGE = (44, 15)  # room for Tux's elbow
    LINES = ["$ make -j8", "  CC kernel/fork.o", "  CC mm/mmap.o", "  CC fs/ext4/inode.o", "  CC net/ipv4/tcp.o",
             "  LD vmlinux", "  Kernel: bzImage", "$ " + BRAND["upgrade"], *BRAND["sync"], "$ ping -c1 tux", "64 bytes: 0.04ms", "$ uptime", " up 999 days",
             "$ fortune", "fish > bugs", "$ cowsay moo", "< moo >", "$ ls ~/fish", "salmon.c tuna.py",
             "$ git push", "Everything up-to-", "  date", "$ whoami", " tux"]
    FINAL = ["$ uname -o", "GNU/Linux", "$ cat /etc/issue", BRAND["name"], "$ echo btw", f"I use {BRAND['word']} btw"]

    def over(self, t):  # every line printed, then a moment to read "I use Arch btw"
        return t > (len(self.LINES) + len(self.FINAL)) / 7 + HOLD + 1

    def frame(self, t, done):
        pix, text = {}, {}
        bezel = (88, 92, 104)
        for x in range(18):
            pix[(x, 4)] = pix[(x, 23)] = bezel
        for y in range(4, 24):
            pix[(0, y)] = pix[(17, y)] = bezel
        for x in range(7, 11):
            pix[(x, 24)] = pix[(x, 25)] = (70, 73, 84)
        for x in range(3, 15):
            pix[(x, 26)] = (70, 73, 84)
        n = len(self.LINES) if done else int(t * 7)
        lines = (self.LINES + self.FINAL)[:n] if not done else self.FINAL
        lines = lines[-7:]
        cursor = "█" if int(t * 3) % 2 else " "
        for i, line in enumerate(lines + ["$ " + cursor]):
            for j, ch in enumerate(line[:16]):
                if ch != " ":
                    green = line.startswith("$") and j == 0
                    text[(1 + j, 3 + i)] = (ch, (80, 250, 123) if green else (220, 220, 225) if line.startswith("$")
                                            else (120, 190, 140))
        tux(pix, 21, 3, t, "idle" if done else "type")
        for x in range(18, STAGE_W):  # desk and keyboard
            pix[(x, 25)] = pix[(x, 26)] = (96, 68, 46)
            if x >= 20:
                pix[(x, 23)] = (110, 115, 128) if x % 2 else (78, 82, 94)
                pix[(x, 24)] = (62, 65, 77)
        return pix, text


def line(pix, x0, y0, x1, y1, color):
    n = int(max(abs(x1 - x0), abs(y1 - y0)) * 2) + 1
    for i in range(n + 1):
        k = i / n
        pix[(round(x0 + (x1 - x0) * k), round(y0 + (y1 - y0) * k))] = color


def sprite(pix, rows, colors, ox, oy):
    for y, row in enumerate(rows):
        for x, ch in enumerate(row):
            if ch != ".":
                pix[(ox + x, oy + y)] = colors[ch]


class Fishing:
    """Tux ice fishing off a floe: the bobber dips, and he reels one in."""
    FISH = ["..BBB..B", ".BBBBBBB", "BEBBBBB.", ".BBBBBBB", "..BBB..B"]

    def over(self, t):  # fish landed
        return t > 3.1 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        bob = round(math.sin(t * 2) * 0.6)
        for x in range(STAGE_W):  # water with moving wave crests
            for y in range(24, 30):
                crest = y == 24 and math.sin(x * 0.5 + t * 3) > 0.2
                pix[(x, y)] = (90, 150, 210) if crest else scale((30, 80, 140), 1 - (y - 24) * 0.08)
        for x in range(1, 24):  # ice floe
            for y in range(22 + bob, 26 + bob):
                if not (y == 22 + bob and x in (1, 23)):
                    pix[(x, y)] = (235, 242, 252) if y == 22 + bob else (180, 205, 232)
        tux(pix, 4, bob, t, "fish")
        tip = (36, 2 + bob)
        line(pix, 21, 11 + bob, *tip, (150, 110, 70))  # rod
        if done:
            stage, caught = 3, 1.0
        else:
            stage = 0 if t < 1.8 else 1 if t < 2.4 else 2 if t < 3.1 else 3
            caught = 0 if stage < 2 else min(1.0, (t - 2.4) / 0.7)
        if stage <= 1:
            dip = 0 if stage == 0 else (2 if int(t * 10) % 2 else 1)
            line(pix, *tip, 36, 23 + dip, (200, 200, 210))
            pix[(36, 23 + dip)] = pix[(37, 23 + dip)] = (238, 62, 62)  # bobber
            pix[(36, 24 + dip)] = pix[(37, 24 + dip)] = (240, 240, 245)
            if stage == 1:
                text[(35, 10)] = ("!", (255, 214, 0))
        else:
            fy = round(26 - caught * 14)
            line(pix, *tip, 36, fy, (200, 200, 210))
            wiggle = int(t * 8) % 2 if stage == 3 else 0
            sprite(pix, self.FISH, {"B": (95, 170, 240), "E": (16, 16, 20)}, 32 + wiggle, fy)
            if stage == 3:
                for i in range(3):
                    if math.sin(t * 4 + i * 2) > -0.2:
                        text[(26 + i * 4, 2 + (i % 2))] = ("♥", (255, 105, 140))
        return pix, text


class Rocket:
    """Countdown, liftoff, and Tux heading for orbit in a rocket with a porthole."""
    STAGE = (40, 18)  # the launch smoke

    BODY = [".....BB.....", "....BBBB....", "...BBBBBB...", "...WWWWWW...", "..WWWWWWWW..",
            "..WWKKKKWW..", "..WKKWWKKW..", "..WKKYYKKW..", "..WWKKKKWW..", "..WWWWWWWW..",
            "..WWGWWGWW..", "..WWWWWWWW..", "..WWWWWWWW..", ".BWWWWWWWWB.", "BBWWWWWWWWBB",
            "BBWWWWWWWWBB", "BB.GGGGGG.BB", "B...GGGG...B"]
    COL = {"B": BRAND_BLUE, "W": (225, 228, 235), "K": (62, 65, 77), "Y": (255, 178, 36), "G": (120, 125, 140)}

    def __init__(self):
        r = random.Random()
        self.stars = [(r.uniform(0, 40), r.uniform(0, 30), r.uniform(0.4, 1.0)) for _ in range(40)]

    def frame(self, t, done):
        pix, text = {}, {}
        lift = 99 if done else max(0.0, t - 1.5)
        speed = min(40.0, lift * lift * 18)          # px/s the world scrolls down
        travel = 99 if done else (lift ** 3) * 6     # how far we've gone
        for sx, sy, b in self.stars:
            y = 2 + (sy + travel * b) % 25  # keep clear of the text rows
            streak = 1 + int(min(4, speed * b / 10)) if not done else 1
            for k in range(min(streak, int(y) - 1)):
                pix.setdefault((int(sx), int(y) - k), scale((220, 225, 240), b * (1 - k / (streak + 1))))
        rise = min(8.0, lift * 6)
        rx, ry = 14, round(9 - rise)
        if lift < 0.01:
            shake = random.choice((-1, 0, 1)) if t > 0.6 else 0
            rx += shake if t > 1.0 else 0
        ground = 28 + travel
        if ground < 30:
            for x in range(STAGE_W):
                for y in range(int(ground), 30):
                    pix[(x, y)] = (70, 73, 84) if y == int(ground) else (45, 47, 55)
        flame_len = 3 + (0 if lift == 0 and t < 1.0 else 3 + int(min(lift, 1) * 4))
        for k in range(flame_len):  # flickering exhaust
            half = max(0.5, 2.6 - k * 0.35 + random.uniform(-0.6, 0.6))
            c = (255, 250, 220) if k < 2 else (255, 200, 60) if k < 4 else (255, 120, 40) if k < 7 else (200, 60, 40)
            for x in range(int(rx + 6 - half), int(rx + 6 + half)):
                pix[(x, ry + 18 + k)] = c
        if lift < 1.2 and t > 0.8:  # smoke on the pad
            for i in range(14):
                a = i * 0.45
                d = (t - 0.8) * 9 + (i % 3)
                px, py = rx + 6 + math.cos(a) * d * 1.4, ground - 1 - abs(math.sin(a)) * d * 0.4
                pix.setdefault((int(px), int(py)), (150, 150, 160))
        sprite(pix, self.BODY, self.COL, rx, ry)
        put_text(text, 1, 0, "$ ./launch.sh"[:max(0, int(t * 30))], (200, 200, 205))
        if done or lift > 0:
            msg, col = ("LIFTOFF", (255, 200, 60)) if not done and lift < 1.5 else ("next stop: orbit", (150, 160, 175))
        else:
            msg, col = f"T-{3 - min(2, int(t / 0.5))}", (255, 255, 255)
        put_text(text, 1, 14, msg, col)
        return pix, text


class Tetris:
    """A round of Tetris in an Arch-blue well, ending in a four-line clear."""
    STAGE = (32, 15)  # the well and the score beside it
    W, H = 10, 13
    PIECES = [("O", [(0, 0), (1, 0), (0, 1), (1, 1)], 0, (255, 214, 0)),
              ("T", [(0, 0), (1, 0), (2, 0), (1, 1)], 3, (170, 90, 220)),
              ("L", [(0, 0), (0, 1), (0, 2), (1, 2)], 6, (255, 150, 40)),
              ("I", [(0, 0), (0, 1), (0, 2), (0, 3)], 9, (60, 210, 230))]
    COLORS = [(238, 62, 62), (80, 220, 110), (60, 120, 230), (255, 150, 40), (170, 90, 220)]

    def __init__(self):
        r = random.Random()
        self.board = {}
        for row in range(self.H - 4, self.H):  # four rows with a gap in the last column
            for col in range(self.W - 1):
                if not (row == self.H - 4 and col in (r.randrange(9), 4)):
                    self.board[(col, row)] = r.choice(self.COLORS)
        self.drops = []  # (cells, colour, start, land_row)
        board = dict(self.board)
        for i, (_, cells, col, color) in enumerate(self.PIECES):
            row = 0
            while all((col + dx, row + 1 + dy) not in board and row + 1 + dy < self.H for dx, dy in cells):
                row += 1
            self.drops.append((cells, col, color, i * 0.8, row))
            for dx, dy in cells:
                board[(col + dx, row + dy)] = color
        self.final = board
        self.clear_at = len(self.PIECES) * 0.8 + 0.1
        self.full = [r for r in range(self.H) if all((c, r) in board for c in range(self.W))]

    def over(self, t):  # lines cleared and the score shown
        return t > self.clear_at + 0.5 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        ox, oy = 2, 1
        for y in range(oy - 1, oy + self.H * 2 + 1):  # the well
            pix[(ox - 1, y)] = pix[(ox + self.W * 2, y)] = scale(BRAND_BLUE, 0.8)
        for x in range(ox - 1, ox + self.W * 2 + 1):
            pix[(x, oy + self.H * 2)] = scale(BRAND_BLUE, 0.8)

        def block(c, r, color):
            for dx in (0, 1):
                pix[(ox + c * 2 + dx, oy + r * 2)] = color
                pix[(ox + c * 2 + dx, oy + r * 2 + 1)] = scale(color, 0.72)

        if done or t > self.clear_at + 0.5:  # after the clear: rows removed, the rest drops
            gone = len(self.full)
            for (c, r), color in self.final.items():
                if r not in self.full:
                    shift = sum(1 for f in self.full if f > r)
                    block(c, r + shift, color)
            lines = gone
        else:
            board = dict(self.board)
            for cells, col, color, start, land in self.drops:
                if t >= start:
                    row = min(land, int((t - start) * 16))
                    for dx, dy in cells:
                        board[(col + dx, row + dy)] = color
            flash = t > self.clear_at and int(t * 12) % 2
            for (c, r), color in board.items():
                block(c, r, (255, 255, 255) if flash and r in self.full else color)
            lines = 0
        hue = t * 0.8
        put_text(text, 25, 1, "SCORE", (150, 160, 175))
        put_text(text, 25, 2, f"{lines * 200:06d}", (230, 230, 235))
        put_text(text, 25, 4, "LINES", (150, 160, 175))
        put_text(text, 25, 5, str(lines), (230, 230, 235))
        if lines:
            for i, ch in enumerate("TETRIS!" if lines == 4 else "NICE!"):
                text[(25 + i, 8)] = (ch, hsv(hue + i * 0.1, 0.6))
        return pix, text


class Debug:
    """Tux flies a little ship and shoots down every bug in the codebase."""
    SHIP = ["...KKKKK...", "..KWEKWEK..", "..KKYYYKK..", ".KKWWWWWKK.", "KKWWWWWWWKK", "K.KWWWWWK.K", "...YY.YY..."]
    BUG = [["..G...G..", ".GGGGGGG.", "GG.GGG.GG", "GGGGGGGGG", ".G.G.G.G.", "G.......G"],
           ["..G...G..", ".GGGGGGG.", "GG.GGG.GG", "GGGGGGGGG", ".G.G.G.G.", ".G.....G."]]

    def __init__(self):
        self.bugs = [[c * 12 + 3, r * 7 + 3, True, hsv(0.3 + r * 0.35 + c * 0.05, 0.6, 0.95)]
                     for r in range(2) for c in range(3)]
        self.shots, self.booms, self.last, self.fired = [], [], 0.0, 0.0
        self.ship_x = 15.0

    def over(self, t):  # last bug squashed and its explosion faded (or it's taking far too long)
        if any(b[2] for b in self.bugs):
            return t > 20
        return t > max((b[2] for b in self.booms), default=0) + 0.6 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        dt, self.last = t - self.last, t
        sway = round(math.sin(t * 2) * 3)
        alive = [b for b in self.bugs if b[2]]
        if done:
            for b in self.bugs:
                b[2] = False
            alive = []
        target = (min(alive, key=lambda b: (-b[1], abs(b[0] + sway + 4 - self.ship_x - 5)))[0] + sway + 4 - 5
                  if alive else 15)
        self.ship_x += max(-30 * dt, min(30 * dt, target - self.ship_x))
        if alive and t - self.fired > 0.32 and abs(target - self.ship_x) < 2:
            self.fired = t
            self.shots.append([self.ship_x + 5, 19.0])
        for s in self.shots:
            s[1] -= 45 * dt
            for b in alive:
                if b[2] and b[0] + sway <= s[0] <= b[0] + sway + 8 and b[1] <= s[1] <= b[1] + 5:
                    b[2], s[1] = False, -99
                    self.booms.append([b[0] + sway + 4, b[1] + 2, t, b[3]])
        self.shots = [s for s in self.shots if s[1] > -2]
        for b in self.bugs:
            if b[2]:
                sprite(pix, self.BUG[int(t * 4) % 2], {"G": b[3]}, b[0] + sway, b[1])
        for x, y, born, color in self.booms:
            age = t - born
            if age < 0.6:
                for i in range(8):
                    a = i * math.pi / 4
                    pix[(round(x + math.cos(a) * age * 12), round(y + math.sin(a) * age * 8))] = color
        for sx, sy in self.shots:
            pix[(round(sx), round(sy))] = pix[(round(sx), round(sy) + 1)] = (255, 230, 120)
        sprite(pix, self.SHIP, PAL, round(self.ship_x), 20)
        left = sum(1 for b in self.bugs if b[2])
        if left:
            put_text(text, 1, 14, f"bugs remaining: {left}", (150, 160, 175))
        else:
            put_text(text, 1, 14, "0 bugs. ship it!", (80, 250, 123))
        return pix, text


class Aquarium:
    """Tux goes for a swim: fish drift by, seaweed sways, bubbles rise."""
    FISH = ["C.CCC.", "CCCCEC", "C.CCC."]

    def __init__(self):
        r = random.Random()
        self.fish = [(r.uniform(0, 50), r.choice((3, 6, 16, 20)), r.uniform(3, 7), r.choice((-1, 1)),
                      r.choice(((255, 150, 40), (255, 214, 0), (255, 120, 160), (120, 220, 200))))
                     for _ in range(4)]

    def frame(self, t, done):
        pix, text = {}, {}
        for y in range(30):  # water, darker with depth, with slanting light rays near the top
            base = scale((24, 90, 150), 1 - y * 0.022)
            for x in range(STAGE_W):
                ray = y < 18 and (x + y * 0.5 + t * 2) % 13 < 2
                pix[(x, y)] = scale(base, 1.25) if ray else base
        for x in range(STAGE_W):  # sand
            for y in range(27, 30):
                pix[(x, y)] = (194, 170, 120) if (x * 7 + y * 3) % 11 else (160, 140, 100)
        for sx, height in ((3, 13), (7, 9), (35, 15), (38, 8)):  # seaweed
            for k in range(height):
                y = 26 - k
                pix[(sx + round(math.sin(t * 2 + k * 0.4 + sx) * k * 0.12), y)] = (40, 150, 80) if k % 3 else (60, 180, 95)
        for x0, y, speed, d, color in self.fish:
            x = (x0 + speed * t * d) % 52 - 6
            rows = self.FISH if d > 0 else [r[::-1] for r in self.FISH]
            sprite(pix, rows, {"C": color, "E": (16, 16, 20)}, round(x), y)
        bob = round(math.sin(t * 1.6) * 1.5)
        tux(pix, 10, 3 + bob, t, "swim")
        for i in range(6):  # bubbles from the beak
            age = (t * 0.7 + i / 6) % 1
            bx = 20 + round(math.sin(t * 3 + i) * 1.2 + i % 2)
            by = round(9 + bob - age * 11)
            if by >= 0:
                pix[(bx, by)] = (200, 230, 255)
        return pix, text


class Campfire:
    """Tux toasting a marshmallow over a crackling campfire under the stars."""
    STAGE = (40, 15)
    W, H, FX, FY = 12, 14, 25, 12
    FIRE = [None, (60, 10, 5), (100, 20, 5), (150, 35, 5), (190, 55, 5), (220, 80, 10), (240, 110, 15),
            (250, 140, 20), (255, 170, 30), (255, 200, 60), (255, 225, 110), (255, 240, 170), (255, 250, 220)]

    def __init__(self):
        r = random.Random()
        self.heat = [[0] * self.W for _ in range(self.H)]
        self.stars = [(r.randrange(STAGE_W), r.randrange(11), r.uniform(0, 6)) for _ in range(18)]
        self.sparks, self.steps = [], 0

    def step(self):  # the classic Doom fire: heat rises, drifts sideways, cools
        top = len(self.FIRE) - 1
        self.heat[-1] = [top if 2 <= x < self.W - 2 else top // 2 for x in range(self.W)]
        for y in range(1, self.H):
            for x in range(self.W):
                drift = random.randint(-1, 1)
                nx = min(self.W - 1, max(0, x + drift))
                self.heat[y - 1][nx] = max(0, self.heat[y][x] - random.choice((0, 1, 1, 2)))
        if random.random() < 0.3:
            self.sparks.append([self.FX + random.uniform(3, 9), self.FY + 3, random.uniform(-2, 2), 0.0])

    def frame(self, t, done):
        pix, text = {}, {}
        while self.steps < int(t * 20):
            self.steps += 1
            self.step()
        for sx, sy, ph in self.stars:
            if math.sin(t * 2 + ph) > -0.3:
                pix[(sx, sy)] = (200, 205, 220)
        for x in range(STAGE_W):  # ground
            for y in range(27, 30):
                pix[(x, y)] = (34, 44, 34) if y == 27 else (26, 32, 26)
        for x in range(23, 39, 2):  # stone ring
            pix[(x, 27)] = (110, 112, 120)
        for y, row in enumerate(self.heat):
            for x, h in enumerate(row):
                if h:
                    pix[(self.FX + x, self.FY + y)] = self.FIRE[h]
        line(pix, 24, 26, 37, 24, (110, 70, 40))  # logs
        line(pix, 24, 24, 37, 26, (90, 58, 34))
        for s in self.sparks:
            s[0] += s[2] * 0.05
            s[1] -= 0.6
            s[3] += 0.05
            if s[1] > 0:
                pix[(round(s[0]), round(s[1]))] = (255, 180, 60)
        self.sparks = [s for s in self.sparks if s[1] > 0 and s[3] < 1.2]
        tux(pix, -2, 5, t, ("pose", 0.5 + 0.05 * math.sin(t * 2), 1.25, (0, 0)))
        line(pix, 16, 16, 27, 10, (150, 110, 70))  # stick
        toast = (t % 12) / 12  # white, then golden, then oops
        c = tuple(int(a + (b - a) * min(1, toast * 1.6)) for a, b in zip((245, 245, 240), (190, 120, 50)))
        for dx in (0, 1):
            for dy in (0, 1):
                pix[(27 + dx, 9 + dy)] = c
        return pix, text


class ServerRoom:
    """Night shift in the server room: blinking racks, hot coffee, and your real load average."""

    def __init__(self):
        r = random.Random()
        self.leds = [(x0 + lx, 2 + u * 3, r.uniform(1, 6), r.uniform(0, 6),
                      r.choice(((80, 250, 123), (80, 250, 123), (255, 190, 60), BRAND_BLUE)))
                     for x0 in (0, 30) for u in range(8) for lx in (2, 4, 6)]
        self.load, self.load_at = "", -9.0

    def frame(self, t, done):
        pix, text = {}, {}
        for x0 in (0, 30):  # two racks
            for y in range(0, 26):
                for x in range(x0, x0 + 10):
                    edge = x in (x0, x0 + 9) or y in (0, 25)
                    pix[(x, y)] = (48, 50, 58) if edge else (28, 30, 36) if y % 3 else (38, 40, 48)
        for x, y, rate, ph, color in self.leds:
            on = math.sin(t * rate + ph) > 0.2 or random.random() < 0.08
            pix[(x, y)] = color if on else scale(color, 0.2)
        for x in range(STAGE_W):  # floor tiles
            for y in (26, 27):
                pix[(x, y)] = (52, 54, 62) if (x // 4 + y) % 2 else (42, 44, 52)
        sip = (t % 8) < 1.3
        ar = 2.3 if sip else 1.05
        tux(pix, 10, 4, t, ("pose", 0.45 + 0.04 * math.sin(t * 2), ar, (0, 0)))
        mx = round(10 + 16.5 + math.sin(ar) * 6.5)
        my = round(4 + 10 + math.cos(ar) * 6.5) - 2
        for dx in range(3):  # Arch-blue mug with a handle
            for dy in range(3):
                pix[(mx + dx, my + dy)] = BRAND_BLUE if dy else (236, 236, 228)
        pix[(mx + 3, my + 1)] = BRAND_BLUE
        if not sip:
            for k in range(5):  # steam
                age = (t * 1.5 + k / 5) % 1
                pix[(mx + 1 + round(math.sin(t * 3 + k) * 1), my - 1 - round(age * 6))] = scale((200, 200, 210), 1 - age)
        if t - self.load_at > 2:
            self.load_at = t
            self.load = "load " + " ".join(read("/proc/loadavg", "? ? ?").split()[:3])
        put_text(text, (STAGE_W - len(self.load)) // 2, 14, self.load, (150, 160, 175))
        return pix, text


class Fireworks:
    """Fireworks bursting over the night sky, Tux watching from below."""
    STAGE = (40, 19)  # Tux stands below the 15th row

    def __init__(self):
        self.rockets, self.parts, self.last, self.next_launch = [], [], 0.0, 0.2

    def frame(self, t, done):
        pix, text = {}, {}
        dt, self.last = max(0.0, min(0.1, t - self.last)), t
        if t >= self.next_launch:
            self.next_launch = t + random.uniform(0.45, 1.0)
            self.rockets.append([random.uniform(4, 36), 29.0, random.uniform(-26, -20), random.uniform(3, 10),
                                 random.random()])
        for r in self.rockets:
            r[1] += r[2] * dt
            if r[1] <= r[3]:
                n = random.randint(28, 40)
                two_tone = random.random() < 0.4
                for i in range(n):
                    a = i / n * 2 * math.pi
                    sp = random.uniform(8, 14)
                    hue = r[4] + (0.5 if two_tone and i % 2 else 0)
                    self.parts.append([r[0], r[1], math.cos(a) * sp, math.sin(a) * sp * 0.7, 1.3, hue])
        self.rockets = [r for r in self.rockets if r[1] > r[3]]
        for p in self.parts:
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            p[3] += 9 * dt
            p[2] *= 0.985
            p[4] -= dt
        self.parts = [p for p in self.parts if p[4] > 0]
        for x, y, *_ in self.rockets:
            pix[(round(x), round(y))] = (255, 240, 200)
            pix[(round(x), round(y) + 1)] = (200, 120, 50)
        for x, y, _, _, life, hue in self.parts:
            pix[(round(x), round(y))] = hsv(hue, 0.55, min(1.0, life))
        tux(pix, 10, 15, t, ("pose", 0.6 + 0.2 * math.sin(t * 3), 0.6 + 0.2 * math.sin(t * 3 + 1), (0, 0)))
        return pix, text


class Panic:
    """sudo rm -rf /boot, a kernel panic, and Tux reaching for the power button."""
    STAGE = (62, 15)
    TRACE = [("Kernel panic - not syncing:", (255, 110, 110)), ("VFS: Unable to mount root fs", None),
             ("CPU: 0 PID: 1 Comm: init", None), ("Call Trace:", None), (" ? tux_panic+0x42/0x1337", None),
             (" ? oops_begin+0x7a/0xb0", None), ("---[ end Kernel panic ]---", (255, 110, 110))]
    BOOT = ["[ OK ] Mounted /boot", "[ OK ] Started init", "[ OK ] Panic averted"]

    def over(self, t):
        return t > 8.2 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        if done:
            t = 9.0
        if t < 1.4:
            put_text(text, 1, 1, "$ sudo rm -rf /boot"[:int(t * 16)], (220, 220, 225))
            text[(1, 1)] = ("$", (80, 250, 123))
            if int(t * 3) % 2:
                text[(2 + min(19, int(t * 16)), 1)] = ("█", (220, 220, 225))
        elif t < 2.4:  # glitch
            for y in range(0, 30, 2):
                if random.random() < 0.45:
                    shift = random.randint(-6, 6)
                    c = random.choice(((238, 62, 62), (80, 250, 123), BRAND_BLUE, (255, 255, 255), (60, 60, 70)))
                    for x in range(max(0, shift), min(STAGE_W, STAGE_W + shift)):
                        if random.random() < 0.5:
                            pix[(x, y + random.randint(0, 1))] = c
            for _ in range(20):
                text[(random.randrange(STAGE_W), random.randrange(STAGE_ROWS))] = (random.choice("#@%&$?!01"),
                                                                                 (200, 200, 205))
        elif t < 4.6:  # the panic itself, line by line
            for i, (msg, col) in enumerate(self.TRACE[:int((t - 2.4) * 8) + 1]):
                put_text(text, 1, 1 + i, msg, col or (200, 200, 205))
        elif t < 6.2:  # Tux waddles in to the power button
            k = min(1.0, (t - 4.6) / 0.9)
            pressing = t > 5.6
            tux(pix, round(40 - k * 19), 4, t, ("pose", 0.45, 1.6 if pressing else 0.45, (0, 0)) if k >= 1 else "walk")
            color = (80, 250, 123) if pressing else (238, 62, 62)
            for a in range(36, 330, 12):  # power symbol: a ring open at the top, and a bar
                pix[(round(10 + math.sin(math.radians(a)) * 5), round(16 - math.cos(math.radians(a)) * 5))] = color
            for y in range(9, 16):
                pix[(10, y)] = color
            if 5.75 < t < 5.9:  # the screen flashes as it reboots
                for x in range(STAGE_W):
                    for y in range(30):
                        pix[(x, y)] = (235, 235, 240)
        else:  # back up
            for i, msg in enumerate(self.BOOT[:int((t - 6.2) * 3) + 1]):
                row = 2 + i * 2
                put_text(text, 1, row, "[    ]", (90, 90, 110))
                put_text(text, 3, row, "OK", (80, 250, 123))
                put_text(text, 8, row, msg[7:], (210, 210, 215))
            tux(pix, 21, 4, t, "wave")
        return pix, text


class Runner:
    """Tux runs a side-scrolling level, hopping over bugs all the way to the flag."""
    SPEED, OX, BASE = 30.0, 1, 6
    OBST = [48, 88, 122, 165]
    FLAG = 215
    BUG = [".RRR.", "RWRWR", "R.R.R"]

    def __init__(self):
        self.end = (self.FLAG - (self.OX + 26)) / self.SPEED  # scrolling stops at the flag

    def over(self, t):
        return t > self.end + 1.0 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        if done:
            t = self.end + 1.0
        scroll = min(t, self.end) * self.SPEED
        for cx, cy in ((10, 3), (32, 7), (55, 2), (80, 5)):  # clouds drift by slower than the ground
            x = round((cx - scroll * 0.3) % 70 - 12)
            sprite(pix, [".WWW..", "WWWWWW"], {"W": (70, 75, 88)}, x, cy)
        for x in range(STAGE_W):
            pix[(x, 28)] = (80, 170, 90)
            pix[(x, 29)] = (110, 80, 50) if (x + int(scroll)) % 6 else (85, 60, 38)
        for w in self.OBST:
            sprite(pix, self.BUG, {"R": (238, 62, 62), "W": (240, 240, 245)}, round(w - scroll), 25)
        fx = round(self.FLAG - scroll)
        if fx < STAGE_W + 6:
            for y in range(8, 28):
                pix[(fx, y)] = (200, 200, 210)
            for k in range(5):
                for j in range(5 - abs(k - 2) * 2):
                    pix[(fx + 1 + j, 8 + k)] = BRAND_BLUE
        jump = 0.0
        for w in self.OBST:  # hop so the top of the arc lands right over each bug
            tj = (w + 2.5 - self.OX - 10) / self.SPEED - 0.55
            if tj <= t < tj + 1.1:
                jump = 8 * math.sin(math.pi * (t - tj) / 1.1)
        running = t < self.end
        tux(pix, self.OX, self.BASE - round(jump), t, "walk" if running else "wave")
        put_text(text, 26, 0, f"SCORE {int(scroll) * 10:05d}", (200, 200, 205))
        if not running:
            for i, ch in enumerate("LEVEL CLEAR!"):
                text[(22 + i, 2)] = (ch, hsv(t * 0.8 + i * 0.08, 0.6))
        return pix, text


GREEN = (80, 250, 123)


def prompt_line(text, row, cmd, t, start=0.0, cps=16):
    """Type out a shell command with a green $, starting at `start` seconds."""
    shown = ("$ " + cmd)[:max(0, int((t - start) * cps))]
    put_text(text, 1, row, shown, (220, 220, 225))
    if shown:
        text[(1, row)] = ("$", GREEN)
    return len(shown) == len(cmd) + 2


class Train:
    """You typed sl instead of ls: a steam locomotive chugs across the screen."""
    SPEED, START, LEN = 22.0, 0.8, 46

    def __init__(self):
        self.gone = self.START + (STAGE_W + self.LEN) / self.SPEED
        try:
            names = sorted(n for n in os.listdir(os.path.expanduser("~")) if not n.startswith("."))
        except OSError:
            names = []
        self.ls = "  ".join(names)

    def over(self, t):
        return t > self.gone + 1.6 + HOLD

    def x_at(self, t):
        return STAGE_W - (t - self.START) * self.SPEED

    def loco(self, pix, X, t):
        D, R, G, Y, BR = (62, 65, 77), (170, 50, 50), (150, 150, 160), (255, 214, 0), (200, 170, 80)

        def box(x0, x1, y0, y1, c):
            for x in range(X + x0, X + x1 + 1):
                for y in range(y0, y1 + 1):
                    pix[(x, y)] = c

        for i in range(4):  # cowcatcher
            for y in range(18 + i, 22):
                pix[(X + i, y)] = G
        box(3, 20, 12, 19, D)          # boiler
        box(3, 20, 12, 12, (90, 94, 106))
        box(8, 8, 12, 19, BRAND_BLUE)   # boiler bands
        box(14, 14, 12, 19, BRAND_BLUE)
        box(5, 7, 7, 11, D)            # chimney
        box(4, 8, 6, 6, D)
        box(11, 13, 10, 11, BR)        # dome
        box(20, 28, 7, 19, R)          # cab
        box(22, 26, 9, 12, Y)          # lit window
        box(19, 29, 6, 6, D)           # roof
        box(1, 29, 20, 21, D)          # frame
        box(32, 44, 14, 21, D)         # coal car
        box(32, 44, 15, 15, R)
        for x in range(32, 45, 2):
            pix[(X + x, 13)] = (40, 40, 44)
        box(29, 31, 20, 20, G)         # coupling
        a = t * self.SPEED / 2.5
        for cx, r in ((6, 2.5), (12, 2.5), (18, 2.5), (25, 3.2), (35, 2.5), (41, 2.5)):
            disc(pix, X + cx + 0.5, 24.5 - (r - 2.5), r, G)
            pix[(X + cx + round(math.cos(a) * (r - 1)), 24 - round(r - 2.5) + round(math.sin(a) * (r - 1)))] = D
        line(pix, X + 6 + math.cos(a) * 1.5, 24 + math.sin(a) * 1.5,
             X + 18 + math.cos(a) * 1.5, 24 + math.sin(a) * 1.5, R)  # connecting rod

    def frame(self, t, done):
        pix, text = {}, {}
        if done:
            t = self.gone + 1.6
        prompt_line(text, 0, "sl", t, 0.1, 8)
        for x in range(STAGE_W):  # rails and sleepers
            pix[(x, 27)] = (150, 150, 160)
            if x % 3 == 0:
                pix[(x, 28)] = (110, 80, 50)
        if self.START <= t < self.gone:
            for i in range(int((t - self.START) / 0.18) + 1):  # smoke trailing behind the chimney
                born = self.START + i * 0.18
                age = t - born
                if age < 1.6:
                    disc(pix, self.x_at(born) + 6 + age * 5, max(3.5, 5 - age * 5), 0.8 + age * 1.4,
                         scale((200, 200, 210), 1 - age / 1.8))
            self.loco(pix, round(self.x_at(t)), t)
        if t >= self.gone and prompt_line(text, 1, "ls", t, self.gone, 10):
            for i in range(2):
                put_text(text, 1, 2 + i, self.ls[i * 38:(i + 1) * 38], BRAND_BLUE)
        return pix, text


class GitGraph:
    """A commit graph growing: a feature branch splits off, merges back, gets tagged and pushed."""
    NODES = [  # (time, x, y, parents, branch, message)
        (0.6, 3, 10, (), "main", "init: hello tux"),
        (1.2, 9, 10, (0,), "main", "add flippers"),
        (1.8, 15, 20, (1,), "feat", "feat: learn to waddle"),
        (2.4, 17, 10, (1,), "main", "fix: beak colour"),
        (3.0, 22, 20, (2,), "feat", "feat: waddle faster"),
        (3.6, 25, 10, (3,), "main", "docs: add README"),
        (4.3, 31, 10, (5, 4), "merge", "merge feature/waddle"),
        (5.0, 37, 10, (6,), "main", "release v1.0"),
    ]
    COLORS = {"main": BRAND_BLUE, "feat": (255, 150, 40), "merge": (236, 236, 228)}

    def over(self, t):
        return t > 6.6 + HOLD

    def frame(self, t, done):
        import zlib
        pix, text = {}, {}
        if done:
            t = 7.0
        prompt_line(text, 0, "git log --graph", t, 0.0, 30)
        for tn, x, y, parents, br, msg in self.NODES:
            for p in parents:
                _, px, py, _, pbr, _ = self.NODES[p]
                k = max(0.0, min(1.0, (t - (tn - 0.35)) / 0.35))
                if k > 0:
                    color = self.COLORS["feat" if "feat" in (br, pbr) else "main"]
                    line(pix, px, py, px + (x - px) * k, py + (y - py) * k, scale(color, 0.8))
        for tn, x, y, parents, br, msg in self.NODES:
            if t >= tn:
                r = min(1.6, (t - tn) / 0.15 * 1.6)
                disc(pix, x + 0.5, y + 0.5, r, self.COLORS[br])
        put_text(text, 1, 3, "main", BRAND_BLUE)
        if t >= 1.8:
            put_text(text, 13, 12, "feature/waddle", (255, 150, 40))
        if t >= 5.0:
            put_text(text, 35, 3, "v1.0", (255, 214, 0))
        if t < 5.6:
            latest = [n for n in self.NODES if n[0] <= t]
            if latest:
                msg = latest[-1][5]
                put_text(text, 1, 13, "*", self.COLORS[latest[-1][4]])
                put_text(text, 3, 13, f"{zlib.crc32(msg.encode()):08x}"[:7], (255, 214, 0))
                put_text(text, 11, 13, msg, (200, 200, 205))
        elif prompt_line(text, 13, "git push --tags", t, 5.6, 30):
            put_text(text, 1, 14, " * [new tag]  v1.0 -> v1.0", GREEN)
        return pix, text


class Sandwich:
    """make me a sandwich. What? Make it yourself. sudo make me a sandwich. Okay."""
    STAGE = (62, 15)  # Tux holds the sandwich out past column 40
    SANDWICH = ["..BBBBBB..", ".BBBBBBBB.", "LLLLLLLLLL", "TTTTTTTTTT", "CCCCCCCCCC", ".bbbbbbbb."]
    COLS = {"B": (225, 170, 95), "L": (90, 200, 90), "T": (230, 70, 60), "C": (255, 210, 60), "b": (200, 145, 75)}

    def over(self, t):
        return t > 8.0 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        if done:
            t = 8.0
        prompt_line(text, 0, "make me a sandwich", t, 0.1)
        if t > 1.6:
            put_text(text, 1, 1, "make: What? Make it yourself.", (238, 120, 120))
        prompt_line(text, 3, "sudo make me a sandwich", t, 2.2)
        if t > 3.9:
            put_text(text, 1, 4, "[sudo] password: " + "*" * min(4, int((t - 3.9) * 10)), (150, 160, 175))
        if t > 4.6:
            put_text(text, 1, 5, "Okay.", GREEN)
        if t > 4.8:
            k = min(1.0, (t - 4.8) / 0.7)
            ox, oy = round(40 - k * 20), 8
            if k < 1:
                pose = "walk"
            elif t < 7.6:
                pose = ("pose", 1.3, 1.3, (0, 0))
            else:
                pose = "wave"
            tux(pix, ox, oy, t, pose)
            if 5.5 < t < 7.6:  # the sandwich drops into his flippers, then gets eaten bite by bite
                drop = min(1.0, (t - 5.5) / 0.5)
                bites = max(0, int((t - 6.2) / 0.3)) * 2
                rows = [r[:max(0, 10 - bites)] for r in self.SANDWICH]
                sprite(pix, rows, self.COLS, ox + 5, round(-6 + drop * (oy + 18)))
                if t > 6.2:
                    put_text(text, 33, 6 + int((t - 6.2) / 0.3) % 2, "nom", (255, 214, 0))
            if t >= 7.6:
                for i in range(3):
                    if math.sin(t * 4 + i * 2) > -0.2:
                        text[(32 + i * 2, 5 - (i % 2))] = ("♥", (255, 105, 140))
        return pix, text


class Breakout:
    """Breakout plays itself until every brick is gone (the ball catches fire, then the last bricks chain-pop)."""
    STAGE = (40, 15)
    ROWS = 3
    COLORS = [(238, 62, 62), (255, 150, 40), (255, 214, 0)]

    def __init__(self):
        self.bricks = {(c, r) for c in range(8) for r in range(self.ROWS)}
        self.x, self.y, self.vx, self.vy = 20.0, 26.0, 20.0, -70.0
        self.px, self.last, self.cleared, self.trail, self.pops = 16.0, 0.0, None, [], []

    def over(self, t):
        return (self.cleared is not None and t > self.cleared + 0.6 + HOLD) or t > 18

    def brick_at(self, x, y):
        xi, yi = int(x), int(y) - 2
        if 0 <= xi < STAGE_W and xi % 5 != 4 and 0 <= yi < self.ROWS * 3 and yi % 3 != 2:
            return (xi // 5, yi // 3)

    def aim(self):  # send the ball toward the column with the most bricks left
        cols = {}
        for c, r in self.bricks:
            cols[c] = cols.get(c, 0) + 1
        c = max(cols, key=lambda k: (cols[k], random.random()))
        rise = (self.y - 2) / 70
        self.vx = max(-45.0, min(45.0, (c * 5 + 1.5 - self.x) / rise + random.uniform(-3, 3)))
        self.vy = -70.0

    def frame(self, t, done):
        pix, text = {}, {}
        dt, self.last = max(0.0, min(0.1, t - self.last)), t
        fire = t > 2.5
        if done:
            self.bricks.clear()
            self.cleared = self.cleared or t
        steps = int(dt / 0.004) + 1
        for _ in range(steps):
            if self.cleared is not None:
                break
            h = dt / steps
            self.x += self.vx * h
            self.y += self.vy * h
            if self.x < 0:
                self.x, self.vx = -self.x, abs(self.vx)
            if self.x > 39.9:
                self.x, self.vx = 79.8 - self.x, -abs(self.vx)
            if self.y < 0:
                self.y, self.vy = -self.y, abs(self.vy)
            b = self.brick_at(self.x, self.y)
            if b in self.bricks:
                self.bricks.discard(b)
                self.pops.append((b, t))
                if not fire:
                    self.vy = -self.vy
            if self.vy > 0 and self.y >= 27:
                self.y = 27.0
                self.aim()
            if not self.bricks:
                self.cleared = t
        if t > 9 and self.bricks and int(t * 10) != int((t - dt) * 10):  # chain reaction: last ones pop
            b = min(self.bricks)
            self.bricks.discard(b)
            self.pops.append((b, t))
            if not self.bricks:
                self.cleared = t
        self.px += max(-110 * dt, min(110 * dt, self.x - 4 - self.px))
        self.px = max(0.0, min(31.0, self.px))
        for c, r in self.bricks:
            for dx in range(4):
                pix[(c * 5 + dx, 2 + r * 3)] = self.COLORS[r]
                pix[(c * 5 + dx, 3 + r * 3)] = scale(self.COLORS[r], 0.7)
        for (c, r), born in self.pops:
            age = t - born
            if age < 0.35:
                for dx in (0, 3):
                    pix[(c * 5 + dx + round((dx - 1.5) * age * 6), 2 + r * 3 + round(age * 8))] = self.COLORS[r]
        for x in range(round(self.px), round(self.px) + 9):
            pix[(x, 28)] = BRAND_BLUE
            pix[(x, 29)] = scale(BRAND_BLUE, 0.6)
        if self.cleared is None:
            self.trail = (self.trail + [(round(self.x), round(self.y))])[-3:]
            for i, p in enumerate(self.trail):
                pix[p] = scale((255, 140, 40) if fire else (236, 236, 228), 0.4 + 0.3 * i)
        else:
            for i, ch in enumerate("CLEAR!"):
                text[(17 + i, 6)] = (ch, hsv(t * 0.8 + i * 0.1, 0.6))
        return pix, text


class Snake:
    """A python (the snake kind) eats its way to a high score."""
    GW, GH, GOAL = 20, 13, 14
    HEAD, BLUE, YELLOW = (75, 140, 200), (55, 118, 171), (255, 212, 59)

    def __init__(self):
        self.rng = random.Random()
        self.body = [(5, 6), (4, 6), (3, 6)]
        self.apple = self.place()
        self.steps, self.end, self.won = 0, None, False

    def place(self):
        return self.rng.choice([(x, y) for x in range(self.GW) for y in range(self.GH) if (x, y) not in self.body])

    def neighbours(self, p):
        x, y = p
        for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if 0 <= n[0] < self.GW and 0 <= n[1] < self.GH:
                yield n

    def path_to(self, goal):
        from collections import deque
        blocked = set(self.body[:-1])
        start = self.body[0]
        prev, q = {start: None}, deque([start])
        while q:
            p = q.popleft()
            if p == goal:
                while prev[p] != start:
                    p = prev[p]
                return p
            for n in self.neighbours(p):
                if n not in prev and n not in blocked:
                    prev[n] = p
                    q.append(n)

    def step(self, t):
        nxt = self.path_to(self.apple)
        if nxt is None:
            safe = [n for n in self.neighbours(self.body[0]) if n not in self.body[:-1]]
            if not safe:
                self.end = t
                return
            nxt = self.rng.choice(safe)
        self.body.insert(0, nxt)
        if nxt == self.apple:
            if len(self.body) >= self.GOAL:
                self.end, self.won = t, True
                return
            self.apple = self.place()
        else:
            self.body.pop()

    def over(self, t):
        return (self.end is not None and t > self.end + 0.8 + HOLD) or t > 18

    def frame(self, t, done):
        pix, text = {}, {}
        while self.end is None and self.steps < int(t * 16):
            self.steps += 1
            self.step(self.steps / 16)
        while done and self.end is None and self.steps < 2000:  # skipped: play the game out instantly
            self.steps += 1
            self.step(t)

        def cell(p, c):
            for dx in (0, 1):
                pix[(p[0] * 2 + dx, p[1] * 2)] = c
                pix[(p[0] * 2 + dx, p[1] * 2 + 1)] = scale(c, 0.75)

        for x in range(0, STAGE_W, 4):  # faint dotted floor so the board has edges
            for y in range(1, self.GH * 2, 4):
                pix[(x, y)] = (38, 40, 46)
        if self.end is None or not self.won:
            cell(self.apple, (238, 62, 62))
            pix[(self.apple[0] * 2 + 1, self.apple[1] * 2)] = (90, 200, 90)
        for i, p in enumerate(self.body):
            cell(p, self.HEAD if i == 0 else self.BLUE if i % 2 else self.YELLOW)
        hx, hy = self.body[0]
        pix[(hx * 2 + 1, hy * 2)] = (16, 16, 20)  # eye
        put_text(text, 1, 14, f"python  len {len(self.body)}", (150, 160, 175))
        if self.end is not None:
            msg = "high score!" if self.won else "game over"
            for i, ch in enumerate(msg):
                text[(26 + i, 14)] = (ch, hsv(t * 0.8 + i * 0.08, 0.6) if self.won else (238, 120, 120))
        return pix, text


class Cowsay:
    """fortune | cowsay, with a cow that blinks."""
    FORTUNES = [f"I use {BRAND['word']}, btw.", "There's no place like 127.0.0.1", "It's not a bug, it's a feature.",
                "Talk is cheap. Show me the code. -- Linus", "Have you tried turning it off and on again?",
                "Real programmers count from 0.", "Penguins can't fly. Tux can.", "sudo !!",
                "Read The Fine Manual: man man", "Moo-ve fast and break things."]
    COW = [r"        \   ^__^", r"         \  (oo)\_______", r"            (__)\       )\/\ ",
           r"                ||----w |", r"                ||     ||"]

    def __init__(self):
        import textwrap
        lines = textwrap.wrap(random.choice(self.FORTUNES), 26)
        w = max(map(len, lines))
        bubble = [" " + "_" * (w + 2)]
        if len(lines) == 1:
            bubble.append(f"< {lines[0]:<{w}} >")
        else:
            for i, l in enumerate(lines):
                ends = ("/", "\\") if i == 0 else ("\\", "/") if i == len(lines) - 1 else ("|", "|")
                bubble.append(f"{ends[0]} {l:<{w}} {ends[1]}")
        bubble.append(" " + "-" * (w + 2))
        self.bubble, self.lines = len(bubble), bubble + self.COW
        self.printed = 1.0 + len(self.lines) * 0.12

    def over(self, t):
        return t > self.printed + 1.5 + HOLD

    def frame(self, t, done):
        pix, text = {}, {}
        if done:
            t = self.printed + 1.0
        prompt_line(text, 0, "fortune | cowsay", t, 0.0, 24)
        blink = t > self.printed and (t % 2.2) < 0.15
        for i, l in enumerate(self.lines[:max(0, int((t - 1.0) / 0.12) + 1) if t >= 1.0 else 0]):
            if blink:
                l = l.replace("(oo)", "(--)")
            put_text(text, 1, 1 + i, l, (236, 236, 228) if i < self.bubble else (200, 200, 205))
        return pix, text


