class Neofetch:
    """The OG Arch look: neofetch's ASCII logo, revealed line by line."""
    W, ROWS = 40, 19
    TOP, LOW = (64, 190, 240), (23, 137, 204)

    LOGO = F_LOGO if FEDORA else A_LOGO

    def over(self, t):
        return t > 0.15 + len(self.LOGO) * 0.16 + 0.3 + 0.9 + HOLD

    def frame(self, t, done):
        text = {}
        n = len(self.LOGO)
        shimmer_at = 0.15 + n * 0.16 + 0.3      # one sweep down the finished logo
        for i, ln in enumerate(self.LOGO):
            base = self.TOP if i < n // 2 + 1 else self.LOW
            if done:
                shown, front = len(ln), None
            else:
                k = (t - (0.15 + i * 0.16)) / 0.25
                if k <= 0:
                    continue
                shown = int(len(ln) * min(1.0, k))
                front = shown if k < 1 else None
            for j, ch in enumerate(ln[:shown]):
                if ch == " ":
                    continue
                c = base
                if FEDORA:  # Fedora's logo: a blue disc with the white f
                    c = (236, 238, 242) if F_LOGO_WHITE[i][j:j + 1] == "2" else (60, 110, 180)
                if front is not None and front - j < 4:      # bright edge of the reveal
                    c = tuple(int(a + (255 - a) * (1 - (front - j) / 4)) for a in base)
                elif not done:
                    d = (i + j * 0.35) - (t - shimmer_at) * 30
                    if -3 < d < 0:
                        c = tuple(int(a + (255 - a) * (1 + d / 3) * 0.8) for a in base)
                text[(1 + j, i)] = (ch, c)
        return {}, text


